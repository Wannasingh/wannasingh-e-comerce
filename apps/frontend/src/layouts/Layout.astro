---
// Layout.astro — Base layout for all pages | AETHER Cyber-Minimalist Design
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "WANNASINGH — Precision Gear for the Modern Nomad. Advanced performance systems engineered for the global explorer.",
  ogImage = "/og-default.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/shop", label: "SHOP", id: "nav-shop" },
  { href: "/collections", label: "COLLECTIONS", id: "nav-collections" },
  { href: "/specs", label: "SPECS ARCHIVE", id: "nav-specs" },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Theme color -->
    <meta name="theme-color" content="#f7f9fd" />
  </head>

  <body>
    <!-- Skip navigation -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100]
             focus:bg-[var(--primary)] focus:text-[var(--on-primary)]
             focus:px-4 focus:py-2 font-data-label"
    >
      SKIP TO MAIN CONTENT
    </a>

    <!-- ── Navigation ─────────────────────────────────────────────────────── -->
    <nav
      id="main-nav"
      class="fixed top-0 w-full z-50 glass-morphism"
      aria-label="Main navigation"
    >
      <div class="container-aether flex items-center justify-between h-20">

        <!-- Logo -->
        <div class="flex items-center gap-12">
          <a
            href="/"
            id="nav-logo"
            class="font-headline-md font-bold tracking-tighter text-[var(--primary)] no-underline"
            style="font-size: 20px; letter-spacing: -0.03em;"
          >
            WANNASINGH
          </a>

          <!-- Desktop nav links -->
          <div class="hidden md:flex items-center gap-8">
            {navLinks.map((link) => {
              const isActive = currentPath === link.href || currentPath.startsWith(link.href + "/");
              return (
                <a
                  href={link.href}
                  id={link.id}
                  class={`font-data-label text-xs tracking-widest transition-colors duration-200 no-underline
                    ${isActive
                      ? "text-[var(--secondary)] border-b border-[var(--secondary)]"
                      : "text-[var(--on-surface-variant)] hover:text-[var(--secondary)]"
                    }`}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        </div>

        <!-- Right side actions -->
        <div class="flex items-center gap-5">
          <!-- Search input -->
          <div class="hidden lg:flex items-center gap-2 tech-border px-4 py-2 bg-[var(--surface-container-low)]">
            <span class="material-symbols-outlined text-[var(--outline)]" style="font-size: 18px;">
              search
            </span>
            <input
              id="nav-search"
              type="text"
              placeholder="SYSTEM_SEARCH"
              class="bg-transparent border-none outline-none font-data-value text-[var(--on-surface)] placeholder:text-[var(--outline-variant)] w-36 text-xs"
              aria-label="Site search"
            />
          </div>

          <!-- User account -->
          <a
            href="/account"
            id="nav-account"
            class="text-[var(--primary)] hover:text-[var(--secondary)] transition-colors"
            aria-label="My account"
          >
            <span class="material-symbols-outlined" style="font-size: 22px;">person</span>
          </a>

          <!-- Cart -->
          <a
            href="/cart"
            id="nav-cart"
            class="relative text-[var(--primary)] hover:text-[var(--secondary)] transition-colors"
            aria-label="Shopping bag"
          >
            <span class="material-symbols-outlined" style="font-size: 22px;">shopping_bag</span>
            <!-- Cart badge -->
            <span
              id="cart-count"
              class="absolute -top-1.5 -right-1.5 bg-[var(--secondary)] text-[var(--on-secondary)]
                     font-data-value text-[9px] w-4 h-4 flex items-center justify-center hidden"
              aria-live="polite"
            >
              0
            </span>
          </a>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-toggle"
            class="md:hidden text-[var(--primary)] hover:text-[var(--secondary)] transition-colors"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="material-symbols-outlined" style="font-size: 24px;">menu</span>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="hidden md:hidden border-t border-[var(--outline-variant)] bg-[var(--surface)]"
        role="navigation"
        aria-label="Mobile navigation"
      >
        <div class="container-aether py-6 flex flex-col gap-5">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="font-data-label text-xs tracking-widest text-[var(--on-surface-variant)]
                     hover:text-[var(--secondary)] transition-colors no-underline"
            >
              {link.label}
            </a>
          ))}
          <!-- Mobile search -->
          <div class="flex items-center gap-2 tech-border px-4 py-2 mt-2">
            <span class="material-symbols-outlined text-[var(--outline)]" style="font-size: 18px;">search</span>
            <input
              type="text"
              placeholder="SYSTEM_SEARCH"
              class="bg-transparent border-none outline-none font-data-value text-xs w-full placeholder:text-[var(--outline-variant)]"
              aria-label="Site search"
            />
          </div>
        </div>
      </div>
    </nav>

    <!-- ── Main Content ────────────────────────────────────────────────────── -->
    <main id="main-content" class="pt-20">
      <slot />
    </main>

    <!-- ── Footer ─────────────────────────────────────────────────────────── -->
    <footer class="bg-[var(--surface-container-lowest)] border-t border-[var(--outline-variant)]">
      <div class="container-aether py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

          <!-- Brand column -->
          <div class="lg:col-span-1">
            <a
              href="/"
              class="font-headline-md font-bold text-[var(--primary)] no-underline block mb-5"
              style="font-size: 18px;"
            >
              WANNASINGH
            </a>
            <p class="font-caption text-[var(--on-surface-variant)] max-w-xs leading-relaxed" style="font-size: 12px;">
              Advanced performance systems for the global explorer.
              Designed in London. Tested in the Extremes.
            </p>
          </div>

          <!-- Explore -->
          <div>
            <h4 class="font-data-label text-[var(--primary)] mb-5" style="font-size: 12px;">EXPLORE</h4>
            <ul class="space-y-3">
              {[
                { href: "/shop", label: "SHOP ALL" },
                { href: "/specs", label: "TECHNICAL SPECS" },
                { href: "/repair", label: "REPAIR PROGRAM" },
              ].map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="font-data-label text-[var(--on-surface-variant)] hover:text-[var(--secondary)]
                           transition-colors no-underline"
                    style="font-size: 11px;"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Company -->
          <div>
            <h4 class="font-data-label text-[var(--primary)] mb-5" style="font-size: 12px;">COMPANY</h4>
            <ul class="space-y-3">
              {[
                { href: "/environment", label: "ENVIRONMENTAL IMPACT" },
                { href: "/terms", label: "TERMS" },
                { href: "/careers", label: "CAREERS" },
              ].map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="font-data-label text-[var(--on-surface-variant)] hover:text-[var(--secondary)]
                           transition-colors no-underline"
                    style="font-size: 11px;"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Connect -->
          <div>
            <h4 class="font-data-label text-[var(--primary)] mb-5" style="font-size: 12px;">CONNECT</h4>
            <div class="flex gap-4">
              {[
                { icon: "language", label: "Website" },
                { icon: "alternate_email", label: "Email" },
                { icon: "share", label: "Social" },
              ].map((btn) => (
                <button
                  class="text-[var(--outline)] hover:text-[var(--secondary)] transition-colors"
                  aria-label={btn.label}
                >
                  <span class="material-symbols-outlined" style="font-size: 22px;">{btn.icon}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-14 pt-6 border-t border-[var(--outline-variant)] flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <span class="font-data-label text-[var(--on-surface-variant)]" style="font-size: 10px;">
            © {new Date().getFullYear()} WANNASINGH PERFORMANCE SYSTEMS. ALL RIGHTS RESERVED.
          </span>
          <div class="flex gap-6">
            <span class="font-data-value text-[var(--outline-variant)]" style="font-size: 11px;">BUILD: v2.4.0-STABLE</span>
            <span class="font-data-value text-[var(--outline-variant)]" style="font-size: 11px;">ENCRYPTION: AES-256</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- ── Scripts ─────────────────────────────────────────────────────────── -->
    <script>
      // Mobile menu toggle
      const toggle = document.getElementById("mobile-menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      toggle?.addEventListener("click", () => {
        const isOpen = mobileMenu?.classList.contains("hidden") === false;
        mobileMenu?.classList.toggle("hidden");
        toggle.setAttribute("aria-expanded", String(!isOpen));
        const icon = toggle.querySelector(".material-symbols-outlined");
        if (icon) icon.textContent = isOpen ? "menu" : "close";
      });

      // Scroll-reveal — observe all .reveal elements
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));
    </script>
  </body>
</html>
