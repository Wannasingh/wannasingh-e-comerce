    document.getElementById('address-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      clearFieldErrors(form);
      const fd = new FormData(form);
      const id = fd.get('address_id') as string;
      const required = ['first_name', 'last_name', 'address_1', 'city', 'postal_code', 'country_code'];
      let valid = true;
      required.forEach(field => {
        if (!(fd.get(field) as string)?.trim()) {
          const g = (form.querySelector(`[name=${field}]`) as HTMLElement)?.closest('.field-group');
          if (g) showFieldError(g, 'Required');
          valid = false;
        }
      });
      if (!valid) return;

      const payload: Record<string,any> = {};
      fd.forEach((v, k) => {
        if (k === 'address_id' || k === 'is_default') return;
        payload[k] = v;
      });

      const isDefaultCheckbox = form.querySelector('[name=is_default]') as HTMLInputElement;
      const isDefault = !!isDefaultCheckbox?.checked;
      payload.metadata = {
        is_default: isDefault
      };

      try {
        let newId = id;
        if (id) {
          await apiRequest(`/store/customers/me/addresses/${id}`, { method: 'POST', body: JSON.stringify(payload) });
        } else {
          const res = await apiRequest('/store/customers/me/addresses', { method: 'POST', body: JSON.stringify(payload) });
          newId = res.address?.id || res.id;
        }

        // If this address is set to default, unset all other addresses' defaults
        if (isDefault && customerData?.addresses) {
          for (const otherAddr of customerData.addresses) {
            if (otherAddr.id === newId) continue;
            if (otherAddr.metadata?.is_default) {
              const cleanPayload = {
                first_name: otherAddr.first_name,
                last_name: otherAddr.last_name,
                address_1: otherAddr.address_1,
                address_2: otherAddr.address_2,
                city: otherAddr.city,
                province: otherAddr.province,
                postal_code: otherAddr.postal_code,
                country_code: otherAddr.country_code,
                metadata: {
                  ...otherAddr.metadata,
                  is_default: false
                }
              };
              await apiRequest(`/store/customers/me/addresses/${otherAddr.id}`, { method: 'POST', body: JSON.stringify(cleanPayload) }).catch(err => {
                console.error("Failed to unset default on other address:", otherAddr.id, err);
              });
            }
          }
        }

        await loadCustomer();
        document.getElementById('address-modal')!.classList.add('hidden');
        showToast(id ? 'Address updated' : 'Address added', 'success');
      } catch (err: any) {
        const errEl = document.querySelector<HTMLElement>('.addr-form-error')!;
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      }
    });

