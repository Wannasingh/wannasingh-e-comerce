---
// src/pages/account.astro — Personal Data Management | AETHER Command Center v2
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="WANNASINGH | My Account"
  description="Manage your WANNASINGH account — personal data, addresses, order history and security settings."
>
  <!-- Auth guard overlay (shown if not logged in) -->
  <div
    id="auth-guard"
    class="fixed inset-0 z-[999] bg-[var(--background)] flex flex-col items-center justify-center gap-6 hidden"
  >
    <div class="w-16 h-16 border-2 border-[var(--secondary)] flex items-center justify-center">
      <span class="material-symbols-outlined text-[var(--secondary)]" style="font-size: 32px;">lock</span>
    </div>
    <div class="text-center">
      <p class="font-data-label text-xs text-[var(--secondary)] tracking-widest uppercase mb-2">Access Denied</p>
      <p class="font-caption text-[11px] text-[var(--on-surface-variant)] mb-6">Authentication required to access your account.</p>
      <a href="/auth" class="inline-flex items-center gap-3 bg-[var(--primary)] text-[var(--on-primary)] px-8 py-4 font-data-label text-xs tracking-[0.2em] hover:bg-[var(--secondary)] transition-all no-underline">
        <span>SIGN IN</span>
        <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
      </a>
    </div>
  </div>

  <!-- Leaflet assets -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <div class="relative py-12 max-w-[1440px] mx-auto px-4 md:px-16">
    <div class="tech-grid absolute inset-0 pointer-events-none opacity-[0.04]"></div>

    <!-- ── Dashboard Header ──────────────────────────────────────────────── -->
    <header class="relative mb-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-[var(--outline-variant)]/30 pb-8 reveal">
      <div class="space-y-2">
        <p class="font-caption text-xs text-[var(--secondary)] uppercase tracking-[0.2em]">Account / Profile</p>
        <h1 class="font-display text-4xl md:text-5xl text-[var(--primary)] uppercase leading-none">My Account</h1>
      </div>
      <div class="flex flex-col items-start md:items-end gap-2">
        <div class="px-4 py-1.5 border border-[var(--primary)] flex items-center gap-3">
          <span class="w-2 h-2 bg-[var(--secondary)] animate-pulse"></span>
          <span id="user-tier" class="font-data-label text-xs uppercase tracking-wider text-[var(--primary)]">Level 01 Collector</span>
        </div>
        <p id="user-operative-id" class="font-data-value text-xs text-[var(--on-surface-variant)]">Member ID: —</p>
      </div>
    </header>

    <!-- ── Tab Nav ────────────────────────────────────────────────────────── -->
    <nav class="flex gap-0 mb-10 border-b border-[var(--outline-variant)] overflow-x-auto reveal" aria-label="Account sections">
      {[
        { id: "identity",  icon: "fingerprint", label: "PROFILE" },
        { id: "addresses", icon: "location_on", label: "ADDRESSES" },
        { id: "orders",    icon: "inventory_2", label: "ORDERS" },
        { id: "security",  icon: "lock",        label: "SECURITY" },
      ].map((t, i) => (
        <button
          data-tab={t.id}
          class={`account-tab flex items-center gap-2 px-6 py-4 font-data-label text-[11px] uppercase tracking-widest transition-all cursor-pointer border-b-2 whitespace-nowrap ${i === 0 ? "text-[var(--primary)] border-[var(--primary)]" : "text-[var(--on-surface-variant)] border-transparent hover:text-[var(--primary)]"}`}
        >
          <span class="material-symbols-outlined" style="font-size: 16px;">{t.icon}</span>
          {t.label}
        </button>
      ))}
      <div class="ml-auto flex items-center px-6 pb-3">
        <button
          id="logout-btn"
          class="flex items-center gap-2 font-data-label text-[11px] uppercase tracking-widest text-[var(--outline)] hover:text-[var(--error)] transition-colors cursor-pointer border-none bg-transparent"
        >
          <span class="material-symbols-outlined" style="font-size: 16px;">logout</span>
          <span class="hidden md:inline">SIGN OUT</span>
        </button>
      </div>
    </nav>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- SECTION: IDENTITY ────────────────────────────────────────────────── -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <section id="section-identity" class="account-section reveal">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Avatar + Quick Info -->
        <div class="lg:col-span-4 space-y-6">
          <div class="bg-[var(--surface-container-lowest)] border border-[var(--outline-variant)]/30 p-8 relative overflow-hidden scanline-effect">
            <div class="flex justify-between items-start mb-8">
              <h2 class="font-headline-md text-lg uppercase font-bold">Profile</h2>
              <span class="material-symbols-outlined text-[var(--outline)]" style="font-size: 22px;">fingerprint</span>
            </div>

            <!-- Avatar upload -->
            <div class="flex flex-col items-center mb-8">
              <div class="relative group mb-4">
                <div class="w-28 h-28 bg-[var(--surface-container-high)] border border-[var(--outline-variant)]/30 overflow-hidden">
                  <img
                    id="avatar-preview"
                    alt="Profile Avatar"
                    class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 transition-all duration-500"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuANyrq4RmJ5SKFvabKt5uPsrCGV-E3dfJ-UmYeDLnaTqPuBGGAB4tATktPxBnKwxxhmGsiNSNt63FPTB2DO3_ktmiIABUk3RC-O97au5whs6jBGjrMHYzx5tszS8I9ybnmrr5XS2-VaPDItG0g1qpXj9bPBaUQ2y8aLyYaYr9KfYvOY9sC8IZ-6UkXJh9kTcePZPg5evqLk4hrdjY_QRIMqLf-dOiK9BlVrE8Qj8voXV7jfyxqbY4_wHylTFcTVVru38j2V6958uEHo"
                  />
                </div>
                <label
                  for="avatar-input"
                  class="absolute inset-0 flex items-center justify-center bg-[var(--primary)]/60 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer"
                >
                  <span class="material-symbols-outlined text-white" style="font-size: 22px;">photo_camera</span>
                </label>
                <input id="avatar-input" type="file" accept="image/*" class="hidden" />
              </div>
              <p id="user-display-name" class="font-headline-md text-base font-bold text-[var(--primary)] uppercase text-center">—</p>
              <p id="user-display-email" class="font-data-value text-xs text-[var(--outline)] mt-1">—</p>
            </div>

            <!-- Quick stats -->
            <div class="space-y-3">
              <div class="flex justify-between items-start gap-4 border-b border-[var(--outline-variant)]/20 pb-2">
                <span class="font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] shrink-0 pt-0.5">Location</span>
                <span id="user-location" class="font-data-value text-xs text-right break-words max-w-[70%]">—</span>
              </div>
              <div class="flex justify-between items-start gap-4 border-b border-[var(--outline-variant)]/20 pb-2">
                <span class="font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] shrink-0 pt-0.5">Phone</span>
                <span id="user-phone" class="font-data-value text-xs text-right break-words max-w-[70%]">—</span>
              </div>
              <div class="flex justify-between items-start gap-4 border-b border-[var(--outline-variant)]/20 pb-2">
                <span class="font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] shrink-0 pt-0.5">Member Since</span>
                <span id="user-since" class="font-data-value text-xs text-right break-words max-w-[70%]">—</span>
              </div>
            </div>

            <!-- Roles & Admin Actions -->
            <div class="mt-6 pt-6 border-t border-[var(--outline-variant)]/20 space-y-3" id="admin-actions-box">
              <a href="/admin" id="go-admin-btn" class="w-full bg-[var(--secondary)] text-white py-3 px-4 font-data-label text-[11px] tracking-wider hover:brightness-110 transition-all flex items-center justify-center gap-2 no-underline hidden">
                <span class="material-symbols-outlined text-[16px]">terminal</span>
                ADMIN CONTROL CORE
              </a>
              <button id="request-seller-btn" class="w-full border border-[var(--primary)] text-[var(--primary)] py-3 px-4 font-data-label text-[11px] tracking-wider hover:bg-[var(--primary)] hover:text-[var(--surface)] transition-all flex items-center justify-center gap-2 cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">storefront</span>
                <span id="request-seller-text">REQUEST TO BE SELLER</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Edit Profile Form -->
        <div class="lg:col-span-8">
          <div class="bg-[var(--surface-container-lowest)] border border-[var(--outline-variant)]/30 p-8">
            <div class="flex justify-between items-center mb-8">
              <h2 class="font-headline-md text-lg uppercase font-bold">Personal Info</h2>
              <span class="font-caption text-xs text-[var(--secondary)] tracking-widest" id="profile-save-status"></span>
            </div>

            <form id="profile-form" class="space-y-6" novalidate>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="field-group">
                  <label for="prof-firstname" class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">First Name</label>
                  <div class="relative border-b border-[var(--outline-variant)] pb-1">
                    <input id="prof-firstname" name="first_name" type="text" autocomplete="given-name"
                      class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
                      placeholder="First Name" />
                  </div>
                  <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
                </div>
                <div class="field-group">
                  <label for="prof-lastname" class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Last Name</label>
                  <div class="relative border-b border-[var(--outline-variant)] pb-1">
                    <input id="prof-lastname" name="last_name" type="text" autocomplete="family-name"
                      class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
                      placeholder="Last Name" />
                  </div>
                  <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
                </div>
              </div>

              <div class="field-group">
                <label for="prof-email" class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Email Address</label>
                <div class="relative border-b border-[var(--outline-variant)] pb-1">
                  <input id="prof-email" name="email" type="email" autocomplete="email"
                    class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
                    placeholder="your@email.com" />
                </div>
                <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="field-group">
                  <label for="prof-phone" class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Phone Number</label>
                  <div class="relative border-b border-[var(--outline-variant)] pb-1">
                    <input id="prof-phone" name="phone" type="tel" autocomplete="tel"
                      class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
                      placeholder="+1 000 000 0000" />
                  </div>
                </div>
                <div class="field-group">
                  <label for="prof-company" class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Company (Optional)</label>
                  <div class="relative border-b border-[var(--outline-variant)] pb-1">
                    <input id="prof-company" name="company_name" type="text"
                      class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
                      placeholder="Company name" />
                  </div>
                </div>
              </div>

              <div class="pt-4 flex gap-4">
                <button type="submit"
                  class="flex-1 md:flex-none bg-[var(--primary)] text-[var(--on-primary)] py-4 px-10 font-data-label text-xs tracking-[0.2em] hover:bg-[var(--secondary)] transition-all flex items-center justify-center gap-3 group cursor-pointer">
                  <span class="btn-label">SAVE CHANGES</span>
                  <span class="btn-loader hidden">
                    <span class="inline-flex gap-1">
                      <span class="w-1 h-1 bg-white animate-bounce" style="animation-delay:0ms;"></span>
                      <span class="w-1 h-1 bg-white animate-bounce" style="animation-delay:150ms;"></span>
                      <span class="w-1 h-1 bg-white animate-bounce" style="animation-delay:300ms;"></span>
                    </span>
                  </span>
                  <span class="material-symbols-outlined transition-transform group-hover:translate-x-1" style="font-size:16px;">save</span>
                </button>
                <button type="button" id="profile-reset"
                  class="py-4 px-6 border border-[var(--outline)] text-[var(--primary)] font-data-label text-xs tracking-[0.2em] hover:border-[var(--primary)] transition-all cursor-pointer">
                  RESET
                </button>
              </div>

              <p id="profile-error" class="font-caption text-[11px] text-[var(--error)] hidden"></p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- SECTION: ADDRESSES ─────────────────────────────────────────────────── -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <section id="section-addresses" class="account-section hidden reveal">
      <div class="flex justify-between items-center mb-8">
        <div>
          <h2 class="font-headline-md text-lg uppercase font-bold mb-1">Saved Addresses</h2>
          <p class="font-caption text-[11px] text-[var(--on-surface-variant)]">Manage your shipping and billing addresses.</p>
        </div>
        <button id="add-address-btn"
          class="flex items-center gap-2 bg-[var(--primary)] text-[var(--on-primary)] px-6 py-3 font-data-label text-[11px] tracking-widest hover:bg-[var(--secondary)] transition-all cursor-pointer">
          <span class="material-symbols-outlined" style="font-size:16px;">add</span>
          ADD ADDRESS
        </button>
      </div>

      <!-- Address cards grid -->
      <div id="addresses-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Populated by JS -->
        <div class="col-span-full py-16 flex flex-col items-center gap-4 border border-dashed border-[var(--outline-variant)] text-center" id="addresses-empty">
          <span class="material-symbols-outlined text-[var(--outline-variant)]" style="font-size:40px;">location_off</span>
          <p class="font-data-label text-xs text-[var(--outline)] uppercase tracking-widest">No addresses saved yet</p>
          <p class="font-caption text-[11px] text-[var(--on-surface-variant)]">Add your first shipping address to proceed to checkout faster.</p>
        </div>
      </div>

      <!-- Address form modal -->
      <div id="address-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-[var(--primary)]/50 backdrop-blur-sm" id="address-modal-backdrop"></div>
        <div class="relative bg-[var(--surface)] border border-[var(--outline-variant)] p-6 md:p-8 w-full max-w-4xl mx-4 z-10 flex flex-col md:flex-row gap-8 max-h-[95vh] overflow-y-auto md:overflow-visible">
          <!-- Close button -->
          <button id="address-modal-close" class="absolute top-4 right-4 material-symbols-outlined text-[var(--outline)] hover:text-[var(--primary)] cursor-pointer z-20" style="font-size:20px;">close</button>
          
          <!-- Left Column: Form -->
          <div class="flex-1 min-w-0">
            <h3 id="address-modal-title" class="font-headline-md text-base uppercase font-bold mb-6">New Address</h3>
            <form id="address-form" class="space-y-4" novalidate>
              <input type="hidden" name="address_id" id="addr-id" />
              <div class="grid grid-cols-2 gap-4">
                <div class="field-group">
                  <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">First Name</label>
                  <div class="border-b border-[var(--outline-variant)] pb-1">
                    <input name="first_name" type="text" required class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none" placeholder="First Name" />
                  </div>
                  <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
                </div>
                <div class="field-group">
                  <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Last Name</label>
                  <div class="border-b border-[var(--outline-variant)] pb-1">
                    <input name="last_name" type="text" required class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none" placeholder="Last Name" />
                  </div>
                  <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
                </div>
              </div>
              <div class="field-group">
                <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Address Line 1</label>
                <div class="border-b border-[var(--outline-variant)] pb-1">
                  <input name="address_1" type="text" required class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none" placeholder="Street address" />
                </div>
                <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
              </div>
              <div class="field-group">
                <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Address Line 2 (Optional)</label>
                <div class="border-b border-[var(--outline-variant)] pb-1">
                  <input name="address_2" type="text" class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none" placeholder="Apartment, suite, unit, etc." />
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="field-group">
                  <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">City</label>
                  <div class="border-b border-[var(--outline-variant)] pb-1">
                    <input name="city" type="text" required class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none" placeholder="City" />
                  </div>
                  <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
                </div>
                <div class="field-group">
                  <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">State / Province</label>
                  <div class="border-b border-[var(--outline-variant)] pb-1">
                    <input name="province" type="text" class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none" placeholder="State / Province" />
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="field-group">
                  <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Postal Code</label>
                  <div class="border-b border-[var(--outline-variant)] pb-1">
                    <input name="postal_code" type="text" required class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none" placeholder="Postal / Zip Code" />
                  </div>
                  <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
                </div>
                <div class="field-group">
                  <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Country Code</label>
                  <div class="border-b border-[var(--outline-variant)] pb-1">
                    <input name="country_code" type="text" required maxlength="2" class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none" placeholder="Country code (e.g. US)" />
                  </div>
                  <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
                </div>
              </div>
              <label class="flex items-center gap-3 cursor-pointer select-none">
                <input type="checkbox" name="is_default" class="w-3.5 h-3.5 border-[var(--outline-variant)] text-[var(--secondary)] focus:ring-[var(--secondary)] cursor-pointer" />
                <span class="font-caption text-xs uppercase tracking-wider text-[var(--on-surface-variant)]">Set as Default Address</span>
              </label>
              <div class="flex gap-4 pt-2">
                <button type="submit" class="flex-1 bg-[var(--primary)] text-[var(--on-primary)] py-4 font-data-label text-xs tracking-[0.2em] hover:bg-[var(--secondary)] transition-all cursor-pointer">
                  SAVE ADDRESS
                </button>
                <button type="button" id="addr-cancel" class="py-4 px-6 border border-[var(--outline)] font-data-label text-xs tracking-widest hover:border-[var(--primary)] transition-all cursor-pointer">
                  CANCEL
                </button>
              </div>
              <p class="addr-form-error font-caption text-xs text-[var(--error)] hidden"></p>
            </form>
          </div>
          
          <!-- Right Column: Map Helper -->
          <div class="flex-1 min-w-0 flex flex-col border-t md:border-t-0 md:border-l border-[var(--outline-variant)]/30 pt-6 md:pt-0 md:pl-8">
            <h4 class="font-data-label text-xs text-[var(--outline)] uppercase tracking-wider mb-2">Location Map Helper</h4>
            <p class="font-caption text-[11px] text-[var(--on-surface-variant)] mb-4">Click/Tap on the map or search to auto-fill the address details.</p>
            
            <!-- Map Search Box -->
            <div class="flex gap-2 mb-3">
              <div class="flex-1 border-b border-[var(--outline-variant)] pb-1">
                <input id="map-search-input" type="text" class="w-full bg-transparent border-none font-body-md text-xs py-1.5 focus:outline-none text-[var(--on-surface)]" placeholder="Search address/landmark..." />
              </div>
              <button type="button" id="map-search-btn" class="bg-[var(--primary)] text-[var(--on-primary)] px-3 py-1 font-data-label text-[10px] tracking-wider hover:bg-[var(--secondary)] transition-all cursor-pointer">SEARCH</button>
            </div>
            
            <!-- Map container -->
            <div id="address-map" class="w-full bg-[var(--surface-container-low)] border border-[var(--outline-variant)]/30 relative min-h-[220px] md:min-h-[260px] h-[220px] md:h-[260px]">
              <div id="map-loading-overlay" class="absolute inset-0 bg-[var(--surface)]/80 flex items-center justify-center z-[1000] hidden">
                <p class="font-data-label text-[10px] text-[var(--secondary)] tracking-widest uppercase animate-pulse">Reverse Geocoding...</p>
              </div>
            </div>

            <!-- Nearby Suggestions Section -->
            <div class="mt-4 flex-1 flex flex-col min-h-0">
              <h5 class="font-data-label text-[10px] text-[var(--outline)] uppercase tracking-wider mb-2">Nearby Places / Address Variations</h5>
              <div id="map-suggestions" class="grid grid-cols-1 gap-1.5 max-h-[120px] overflow-y-auto pr-1">
                <p class="font-caption text-[10px] text-[var(--on-surface-variant)]/50 italic">Click/search on the map to see suggestions...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- SECTION: ORDERS ─────────────────────────────────────────────────── -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <section id="section-orders" class="account-section hidden reveal">
      <div class="mb-8">
        <h2 class="font-headline-md text-lg uppercase font-bold mb-1">Order History</h2>
        <p class="font-caption text-[11px] text-[var(--on-surface-variant)]">All confirmed and past orders.</p>
      </div>

      <!-- Filter bar -->
      <div class="flex flex-wrap gap-3 mb-6">
        {["ALL", "DELIVERED", "PROCESSING", "RETURNED"].map((f, i) => (
          <button
            data-filter={f.toLowerCase()}
            class={`order-filter font-data-label text-[10px] tracking-widest px-4 py-2 border transition-all cursor-pointer uppercase ${i === 0 ? "border-[var(--primary)] text-[var(--primary)] bg-[var(--primary)]/5" : "border-[var(--outline-variant)] text-[var(--on-surface-variant)] hover:border-[var(--primary)]"}`}
          >
            {f}
          </button>
        ))}
        <div class="ml-auto">
          <input
            id="order-search"
            type="search"
            placeholder="SEARCH ORDER #..."
            class="bg-transparent border-b border-[var(--outline-variant)] py-2 px-0 font-data-label text-[10px] tracking-widest placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:border-[var(--secondary)] w-48 transition-all"
