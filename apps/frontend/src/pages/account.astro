    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- SECTION: SECURITY ──────────────────────────────────────────────── -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <section id="section-security" class="account-section hidden reveal">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Change password -->
        <div class="bg-[var(--surface-container-lowest)] border border-[var(--outline-variant)]/30 p-8">
          <div class="flex justify-between items-start mb-8">
            <h2 class="font-headline-md text-lg uppercase font-bold">Change Password</h2>
            <span class="material-symbols-outlined text-[var(--outline)]" style="font-size:22px;">key</span>
          </div>
          <form id="change-password-form" class="space-y-6" novalidate>
            <div class="field-group">
              <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Current Password</label>
              <div class="relative border-b border-[var(--outline-variant)] pb-1">
                <input name="current_password" type="password" autocomplete="current-password" required
                  class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 pr-8 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
                  placeholder="••••••••••••" />
                <button type="button" class="pw-toggle absolute right-0 bottom-2 text-[var(--outline)] hover:text-[var(--primary)] transition-colors">
                  <span class="material-symbols-outlined" style="font-size:16px;">visibility_off</span>
                </button>
              </div>
              <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
            </div>
            <div class="field-group">
              <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">New Password</label>
              <div class="relative border-b border-[var(--outline-variant)] pb-1">
                <input name="new_password" type="password" autocomplete="new-password" required
                  class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 pr-8 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
                  placeholder="At least 8 characters" />
                <button type="button" class="pw-toggle absolute right-0 bottom-2 text-[var(--outline)] hover:text-[var(--primary)] transition-colors">
                  <span class="material-symbols-outlined" style="font-size:16px;">visibility_off</span>
                </button>
              </div>
              <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
            </div>
            <div class="field-group">
              <label class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">Confirm Password</label>
              <div class="relative border-b border-[var(--outline-variant)] pb-1">
                <input name="confirm_password" type="password" autocomplete="new-password" required
                  class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
                  placeholder="Re-enter password" />
              </div>
              <p class="field-error font-caption text-xs text-[var(--error)] mt-1 hidden"></p>
            </div>
            <button type="submit"
              class="w-full bg-[var(--primary)] text-[var(--on-primary)] py-4 font-data-label text-xs tracking-[0.2em] hover:bg-[var(--secondary)] transition-all flex justify-between items-center px-8 group cursor-pointer">
              <span class="btn-label">UPDATE PASSWORD</span>
              <span class="btn-loader hidden"><span class="inline-flex gap-1"><span class="w-1 h-1 bg-white animate-bounce" style="animation-delay:0ms;"></span><span class="w-1 h-1 bg-white animate-bounce" style="animation-delay:150ms;"></span><span class="w-1 h-1 bg-white animate-bounce" style="animation-delay:300ms;"></span></span></span>
              <span class="material-symbols-outlined transition-transform group-hover:translate-x-1" style="font-size:16px;">lock_reset</span>
            </button>
            <p id="pw-change-msg" class="font-caption text-[11px] hidden text-center"></p>
          </form>
        </div>

        <!-- Network preferences -->
        <div class="space-y-6">
          <div class="bg-[var(--surface-container-lowest)] border border-[var(--outline-variant)]/30 p-8">
            <div class="flex justify-between items-start mb-8">
              <h2 class="font-headline-md text-lg uppercase font-bold">Preferences</h2>
              <span class="material-symbols-outlined text-[var(--outline)]" style="font-size:22px;">settings</span>
            </div>
            <div class="space-y-6">
              {[
                { id: "pref-newsletter", label: "Email Newsletter", desc: "Get notified about new drops, collections and stories.", defaultOn: true },
                { id: "pref-2fa",        label: "Two-Factor Auth",  desc: "Enhanced account security layer",  defaultOn: true },
                { id: "pref-public",     label: "Public Profile",   desc: "Make profile visible to community",    defaultOn: false },
                { id: "pref-marketing",  label: "Exclusive Drop Alerts",   desc: "Get early access and notifications for limited releases.", defaultOn: true },
              ].map(p => (
                <div class="flex items-center justify-between">
                  <div>
                    <p class="font-caption text-xs font-semibold uppercase text-[var(--primary)]">{p.label}</p>
                    <p class="font-caption text-[10px] text-[var(--on-surface-variant)] mt-0.5">{p.desc}</p>
                  </div>
                  <button
                    type="button"
                    class="toggle-switch w-11 h-6 flex items-center px-1 cursor-pointer transition-colors"
                    style={`background: ${p.defaultOn ? "var(--secondary)" : "var(--outline-variant)"}`}
                    data-state={p.defaultOn ? "on" : "off"}
                    id={p.id}
                  >
                    <div
                      class="w-4 h-4 bg-white transition-all"
                      style={p.defaultOn ? "margin-left: auto;" : ""}
                    ></div>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- Danger zone -->
          <div class="bg-[var(--surface-container-lowest)] border border-[var(--error)]/20 p-8">
            <div class="flex justify-between items-start mb-6">
              <h2 class="font-headline-md text-lg uppercase font-bold text-[var(--error)]">Danger Zone</h2>
              <span class="material-symbols-outlined text-[var(--error)]" style="font-size:22px;">warning</span>
            </div>
            <p class="font-caption text-[11px] text-[var(--on-surface-variant)] mb-6">Permanently delete your account and all associated data. This action cannot be undone.</p>
            <button
              id="delete-account-btn"
              type="button"
              class="w-full border border-[var(--error)] text-[var(--error)] py-4 font-data-label text-xs tracking-[0.2em] hover:bg-[var(--error)] hover:text-white transition-all cursor-pointer"
            >
              DELETE ACCOUNT
            </button>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Toast notification -->
  <div
    id="toast"
    class="fixed bottom-8 right-8 z-[100] hidden"
    style="min-width: 280px;"
  >
    <div id="toast-inner" class="border p-4 flex items-center gap-3 shadow-xl">
      <span id="toast-icon" class="material-symbols-outlined" style="font-size: 20px;"></span>
      <p id="toast-msg" class="font-data-label text-xs tracking-wider uppercase flex-1"></p>
      <button onclick="document.getElementById('toast').classList.add('hidden')" class="material-symbols-outlined text-current cursor-pointer opacity-60 hover:opacity-100" style="font-size:16px;">close</button>
    </div>
  </div>

  <style>
    .tech-grid {
      background-image: radial-gradient(circle, var(--outline) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    .scan-line {
      height: 2px;
      background: linear-gradient(to right, transparent, var(--secondary), transparent);
      position: absolute;
      width: 100%;
      animation: scan 5s linear infinite;
      z-index: 5;
    }

    @keyframes scan {
      0%   { top: 0; opacity: 0; }
      15%  { opacity: 0.35; }
      85%  { opacity: 0.35; }
      100% { top: 100%; opacity: 0; }
    }

    .shimmer {
      background: linear-gradient(90deg, var(--surface-container) 25%, var(--surface-container-high) 50%, var(--surface-container) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite linear;
    }

    @keyframes shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Address card hover */
    .address-card:hover { border-color: var(--secondary); }

    /* Order expanded content */
    .order-details { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .order-details.open { max-height: 600px; }

    /* Toast animation */
    #toast.show { animation: toast-in 0.3s ease-out both; }
    @keyframes toast-in {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Leaflet monochrome/AETHER styling */
    #address-map .leaflet-tile-container {
      filter: grayscale(1) invert(0.05) contrast(1.1);
    }
    .leaflet-bar {
      border: 1px solid var(--outline-variant) !important;
      border-radius: 0px !important;
      box-shadow: none !important;
    }
    .leaflet-bar a {
      background-color: var(--surface) !important;
      color: var(--primary) !important;
      border-bottom: 1px solid var(--outline-variant) !important;
      border-radius: 0px !important;
    }
    .leaflet-bar a:hover {
      background-color: var(--surface-container-low) !important;
      color: var(--secondary) !important;
    }
    .leaflet-container {
      font-family: inherit !important;
    }
    .leaflet-marker-shadow {
      display: none !important;
    }
  </style>

  <script>
    import { decryptPayload } from '../lib/crypto';

    /* ── Constants ──────────────────────────────────────────────────────────── */
    const API = (import.meta.env.PUBLIC_MEDUSA_BACKEND_URL as string) || 'http://localhost:9000';
    const PK  = (import.meta.env.PUBLIC_MEDUSA_PUBLISHABLE_KEY as string) || '';

    /* ── Helpers ────────────────────────────────────────────────────────────── */
    function getToken(): string | null {
      return localStorage.getItem('wanna_auth_token');
    }

    async function apiRequest(path: string, options: RequestInit = {}) {
      const token = getToken();
      const headers: Record<string,string> = {
        'Content-Type': 'application/json',
        'x-publishable-api-key': PK,
        ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
      };
      const res = await fetch(`${API}${path}`, { ...options, headers: { ...headers, ...(options.headers as Record<string,string> || {}) }, credentials: 'include' });
      
      const encryptedData = await res.json().catch(() => ({}));
      const body = await decryptPayload(encryptedData);

      if (!res.ok) {
        throw new Error(body.message || `Request failed: ${res.status}`);
      }
      return body;
    }

    function showToast(msg: string, type: 'success' | 'error' | 'info' = 'success') {
      const toast     = document.getElementById('toast')!;
      const inner     = document.getElementById('toast-inner')!;
      const iconEl    = document.getElementById('toast-icon')!;
      const msgEl     = document.getElementById('toast-msg')!;
      const colorMap  = { success: 'var(--secondary)', error: 'var(--error)', info: 'var(--outline)' };
      const iconMap   = { success: 'check_circle', error: 'error', info: 'info' };

      inner.style.borderColor = colorMap[type];
      inner.style.background  = 'var(--surface-container-lowest)';
      iconEl.textContent       = iconMap[type];
      iconEl.style.color       = colorMap[type];
      msgEl.textContent        = msg;

      toast.classList.remove('hidden', 'show');
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => toast.classList.add('hidden'), 4000);
    }

    function setLoading(form: HTMLElement, loading: boolean) {
      const btn    = form.querySelector<HTMLButtonElement>('[type=submit]');
      if (!btn) return;
      const label  = btn.querySelector<HTMLElement>('.btn-label');
      const loader = btn.querySelector<HTMLElement>('.btn-loader');
      btn.disabled = loading;
      label?.classList.toggle('hidden', loading);
      loader?.classList.toggle('hidden', !loading);
    }

    function showFieldError(group: Element, msg: string) {
      const err = group.querySelector<HTMLElement>('.field-error');
      if (err) { err.textContent = msg; err.classList.remove('hidden'); }
    }
    function clearFieldErrors(form: Element) {
      form.querySelectorAll('.field-error').forEach(e => { (e as HTMLElement).textContent = ''; e.classList.add('hidden'); });
    }

    /* ── Auth guard ─────────────────────────────────────────────────────────── */
    const token = getToken();
    if (!token) {
      document.getElementById('auth-guard')!.classList.remove('hidden');
    }

    document.getElementById('logout-btn')?.addEventListener('click', () => {
      localStorage.removeItem('wanna_auth_token');
      localStorage.removeItem('wanna_auth_role');
      localStorage.removeItem('wanna_seller_requested');
      showToast('Signing out. Redirecting…', 'info');
      setTimeout(() => { window.location.href = '/auth'; }, 1200);
    });

    /* ── Delete account confirm ─────────────────────────────────────────────── */
    document.getElementById('delete-account-btn')?.addEventListener('click', async () => {
      const confirmed = await (window as any).showAetherConfirm('CONFIRM DELETE ACCOUNT', 'This will permanently delete your account and all data. This cannot be undone.');
      if (!confirmed) return;
      apiRequest('/store/customers/me', { method: 'DELETE' })
        .then(() => {
          localStorage.removeItem('wanna_auth_token');
          showToast('Account deleted.', 'info');
          setTimeout(() => { window.location.href = '/'; }, 1500);
        })
        .catch(err => showToast(err.message, 'error'));
    });

    /* ── Tab switching ──────────────────────────────────────────────────────── */
    const tabs     = document.querySelectorAll<HTMLElement>('.account-tab');
    const sections = document.querySelectorAll<HTMLElement>('.account-section');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach(t => {
          t.classList.remove('text-[var(--primary)]', 'border-[var(--primary)]');
          t.classList.add('text-[var(--on-surface-variant)]', 'border-transparent');
        });
        tab.classList.add('text-[var(--primary)]', 'border-[var(--primary)]');
        tab.classList.remove('text-[var(--on-surface-variant)]', 'border-transparent');

        sections.forEach(s => {
          s.classList.toggle('hidden', s.id !== `section-${target}`);
        });

        // Lazy load orders when switching to orders tab
        if (target === 'orders') loadOrders();
      });
    });

    /* ── Field focus effects ────────────────────────────────────────────────── */
    function initFieldEffects(root: Element = document.body) {
      root.querySelectorAll<HTMLInputElement>('.field-input').forEach(input => {
        const group  = input.closest('.field-group');
        const border = input.closest('.relative, .border-b') as HTMLElement;
        const label  = group?.querySelector<HTMLElement>('.field-label');

        input.addEventListener('focus', () => {
          if (border) { border.style.borderColor = 'var(--secondary)'; }
          if (label)  { label.style.color = 'var(--secondary)'; }
        });
        input.addEventListener('blur', () => {
          if (border) { border.style.borderColor = ''; }
          if (label)  { label.style.color = ''; }
        });
      });

      // Password toggles
      root.querySelectorAll<HTMLButtonElement>('.pw-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const pw   = btn.previousElementSibling as HTMLInputElement;
          const icon = btn.querySelector('.material-symbols-outlined')!;
          const isText = pw.type === 'text';
          pw.type = isText ? 'password' : 'text';
          icon.textContent = isText ? 'visibility_off' : 'visibility';
        });
      });
    }
    initFieldEffects();

    /* ── Toggle switches ────────────────────────────────────────────────────── */
    document.querySelectorAll<HTMLElement>('.toggle-switch').forEach(toggle => {
      toggle.addEventListener('click', () => {
        const isOn  = toggle.dataset.state === 'on';
        const handle = toggle.querySelector('div') as HTMLElement;
        toggle.dataset.state = isOn ? 'off' : 'on';
        toggle.style.background = isOn ? 'var(--outline-variant)' : 'var(--secondary)';
        handle.style.marginLeft = isOn ? '' : 'auto';
        showToast(isOn ? 'Setting disabled' : 'Setting enabled', 'info');
      });
    });

    /* ── Load customer data ──────────────────────────────────────────────────── */
    let customerData: any = null;

    async function loadCustomer() {
      try {
        const data = await apiRequest('/store/customers/me');
        customerData = data.customer || data;
        fillProfile(customerData);
      } catch {
        // Not authenticated or API down — populate with demo data
        customerData = {
          id: 'demo-001',
          first_name: 'ELIAS',
          last_name: 'VANCE',
          email: 'vance.e@wannasingh.io',
          phone: '+1 212 555 0142',
          company_name: 'TAC-OPS',
          created_at: '2022-03-15T00:00:00Z',
          addresses: [
            { id: 'addr-1', address_1: '42 SECTOR BLVD', city: 'NEW YORK', province: 'NY', postal_code: '10001', country_code: 'US', first_name: 'Elias', last_name: 'Vance', is_default_billing: true },
          ]
        };
        fillProfile(customerData);
      }
    }

    function fillProfile(c: any) {
      const name = `${c.first_name || ''} ${c.last_name || ''}`.trim();
      (document.getElementById('user-display-name') as HTMLElement).textContent = name || '—';
      (document.getElementById('user-display-email') as HTMLElement).textContent = c.email || '—';
      (document.getElementById('user-operative-id') as HTMLElement).textContent = `Member ID: ${c.id?.slice(0,12).toUpperCase() || '—'}`;
      (document.getElementById('user-phone') as HTMLElement).textContent = c.phone || '—';
      (document.getElementById('user-location') as HTMLElement).textContent = c.addresses?.[0]?.city ? `${c.addresses[0].city}, ${c.addresses[0].country_code?.toUpperCase()}` : '—';
      (document.getElementById('user-since') as HTMLElement).textContent = c.created_at ? new Date(c.created_at).getFullYear().toString() : '—';

      // Dynamic Admin/Seller check
      const userTier = document.getElementById('user-tier');
      const goAdminBtn = document.getElementById('go-admin-btn');
      const requestSellerBtn = document.getElementById('request-seller-btn') as HTMLButtonElement | null;
      const requestSellerText = document.getElementById('request-seller-text');

      const isSeller = c.metadata?.seller_approved === 'true';
      const isAdmin = c.email === 'wannasingh.khan@gmail.com';

      if (isAdmin) {
        if (userTier) userTier.textContent = 'SUPER ADMIN';
        if (goAdminBtn) goAdminBtn.classList.remove('hidden');
        localStorage.setItem('wanna_auth_role', 'admin');
      } else if (isSeller) {
        if (userTier) userTier.textContent = 'SELLER';
        if (goAdminBtn) goAdminBtn.classList.remove('hidden');
        localStorage.setItem('wanna_auth_role', 'seller');
      } else {
        if (userTier) userTier.textContent = 'Level 01 Collector';
        if (goAdminBtn) goAdminBtn.classList.add('hidden');
        localStorage.setItem('wanna_auth_role', 'customer');
      }

      // Set seller request button state
      if (requestSellerBtn && requestSellerText) {
        if (c.metadata?.seller_approved === 'true') {
          requestSellerBtn.disabled = true;
          requestSellerBtn.classList.add('opacity-50', 'cursor-not-allowed');
          requestSellerText.textContent = 'SELLER STATUS ACTIVE';
        } else if (c.metadata?.seller_requested === 'true') {
          requestSellerBtn.disabled = true;
          requestSellerBtn.classList.add('opacity-50', 'cursor-not-allowed');
          requestSellerText.textContent = 'SELLER REQUEST PENDING';
        } else {
          requestSellerBtn.disabled = false;
          requestSellerBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          requestSellerText.textContent = 'REQUEST TO BE SELLER';
        }
      }

      // Set Avatar URL if present in metadata
      const avatarPreview = document.getElementById('avatar-preview') as HTMLImageElement;
      if (avatarPreview) {
        avatarPreview.src = c.metadata?.avatar_url || "https://lh3.googleusercontent.com/aida-public/AB6AXuANyrq4RmJ5SKFvabKt5uPsrCGV-E3dfJ-UmYeDLnaTqPuBGGAB4tATktPxBnKwxxhmGsiNSNt63FPTB2DO3_ktmiIABUk3RC-O97au5whs6jBGjrMHYzx5tszS8I9ybnmrr5XS2-VaPDItG0g1qpXj9bPBaUQ2y8aLyYaYr9KfYvOY9sC8IZ-6UkXJh9kTcePZPg5evqLk4hrdjY_QRIMqLf-dOiK9BlVrE8Qj8voXV7jfyxqbY4_wHylTFcTVVru38j2V6958uEHo";
      }

      // Fill profile form
      const f = document.getElementById('profile-form') as HTMLFormElement;
      (f.querySelector('[name=first_name]') as HTMLInputElement).value  = c.first_name || '';
      (f.querySelector('[name=last_name]') as HTMLInputElement).value   = c.last_name  || '';
      (f.querySelector('[name=email]') as HTMLInputElement).value       = c.email      || '';
      (f.querySelector('[name=phone]') as HTMLInputElement).value       = c.phone      || '';
      (f.querySelector('[name=company_name]') as HTMLInputElement).value = c.company_name || '';

      // Addresses
      renderAddresses(c.addresses || []);
    }

    loadCustomer();

    /* ── Profile form ────────────────────────────────────────────────────────── */
    const profileForm = document.getElementById('profile-form') as HTMLFormElement;
    const profileStatus = document.getElementById('profile-save-status')!;


    profileForm.addEventListener('input', () => {
      profileStatus.textContent = 'UNSAVED CHANGES';
      profileStatus.style.color = 'var(--outline)';
    });

    document.getElementById('profile-reset')?.addEventListener('click', () => {
      if (customerData) {
        fillProfile(customerData);
        profileStatus.textContent = 'RESTORED';
        profileStatus.style.color = 'var(--secondary)';
        setTimeout(() => { profileStatus.textContent = ''; }, 2000);
      }
    });

    profileForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearFieldErrors(profileForm);

      const fd = new FormData(profileForm);
      const email = fd.get('email') as string;

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        const g = (profileForm.querySelector('[name=email]') as HTMLElement).closest('.field-group')!;
        showFieldError(g, 'Valid email required');
        return;
      }

      setLoading(profileForm, true);
      profileStatus.textContent = 'SAVING…';
      profileStatus.style.color = 'var(--outline)';

      try {
        const payload: Record<string,string> = {};
        fd.forEach((v, k) => { payload[k] = v as string; });

        await apiRequest('/store/customers/me', {
          method: 'POST',
          body: JSON.stringify(payload),
        });

        customerData = { ...customerData, ...payload };
        fillProfile(customerData);
        profileStatus.textContent = 'CHANGES SAVED';
        profileStatus.style.color = 'var(--secondary)';
        showToast('Profile updated', 'success');
        setTimeout(() => { profileStatus.textContent = ''; }, 3000);
      } catch (err: any) {
        profileStatus.textContent = 'SAVE FAILED';
        profileStatus.style.color = 'var(--error)';
        showToast(err.message || 'Update failed', 'error');
      } finally {
        setLoading(profileForm, false);
      }
    });

    /* ── Avatar upload ───────────────────────────────────────────────────────── */
    document.getElementById('avatar-input')?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = async (ev) => {
        const base64Data = ev.target?.result as string;
        
        try {
          // Set preview locally first for visual responsiveness
          const preview = document.getElementById('avatar-preview') as HTMLImageElement;
          if (preview) preview.src = base64Data;
          
          showToast('Uploading avatar...', 'info');

          // POST to backend API
          const response = await apiRequest('/store/customers/me/avatar', {
            method: 'POST',
            body: JSON.stringify({ avatar: base64Data })
          });

          if (response?.customer) {
            customerData = response.customer;
            fillProfile(customerData);
            showToast('Avatar uploaded successfully', 'success');
          } else {
            throw new Error("Invalid response payload");
          }
        } catch (err: any) {
          console.error("Failed to upload avatar:", err);
          showToast(err.message || 'Avatar upload failed', 'error');
          // Reset avatar preview to original value
          if (customerData) fillProfile(customerData);
        }
      };
      reader.readAsDataURL(file);
    });

    /* ── Addresses ───────────────────────────────────────────────────────────── */
    function renderAddresses(addresses: any[]) {
      const grid  = document.getElementById('addresses-grid')!;
      const empty = document.getElementById('addresses-empty')!;
      // Remove old cards (keep empty placeholder)
      grid.querySelectorAll('.address-card').forEach(c => c.remove());

      if (addresses.length === 0) {
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');

      addresses.forEach((addr) => {
        const card = document.createElement('div');
        card.className = 'address-card border border-[var(--outline-variant)]/30 p-6 relative transition-colors';
        card.dataset.addressId = addr.id;
        card.innerHTML = `
          <div class="flex justify-between items-start mb-4">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[var(--outline)]" style="font-size:18px;">location_on</span>
              <span class="font-caption text-xs uppercase tracking-widest text-[var(--primary)]">${(addr.is_default_billing || addr.metadata?.is_default) ? 'DEFAULT ADDRESS' : 'SAVED ADDRESS'}</span>
            </div>
            <div class="flex gap-2">
              <button class="addr-edit-btn material-symbols-outlined text-[var(--outline)] hover:text-[var(--secondary)] cursor-pointer transition-colors" style="font-size:16px;" data-id="${addr.id}">edit</button>
              <button class="addr-delete-btn material-symbols-outlined text-[var(--outline)] hover:text-[var(--error)] cursor-pointer transition-colors" style="font-size:16px;" data-id="${addr.id}">delete</button>
            </div>
          </div>
          <p class="font-body-md text-sm font-semibold text-[var(--primary)]">${addr.first_name} ${addr.last_name}</p>
          <p class="font-data-value text-xs text-[var(--on-surface-variant)] mt-1">${addr.address_1}${addr.address_2 ? ', ' + addr.address_2 : ''}</p>
          <p class="font-data-value text-xs text-[var(--on-surface-variant)]">${addr.city}${addr.province ? ', ' + addr.province : ''} ${addr.postal_code}</p>
          <p class="font-data-value text-xs text-[var(--on-surface-variant)] uppercase">${addr.country_code}</p>
        `;
        grid.appendChild(card);
      });

      // Edit/delete handlers
      grid.querySelectorAll<HTMLButtonElement>('.addr-edit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id;
          const addr = customerData?.addresses?.find((a: any) => a.id === id);
          if (addr) openAddressModal(addr);
        });
      });
      grid.querySelectorAll<HTMLButtonElement>('.addr-delete-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          const confirmed = await (window as any).showAetherConfirm('Remove Address', 'Are you sure you want to remove this address?');
          if (!confirmed) return;
          try {
            await apiRequest(`/store/customers/me/addresses/${id}`, { method: 'DELETE' });
            customerData.addresses = customerData.addresses?.filter((a: any) => a.id !== id) || [];
            renderAddresses(customerData.addresses);
            showToast('Address removed', 'success');
          } catch (err: any) {
            showToast(err.message, 'error');
          }
        });
      });
    }

    /* ── Map Helper ──────────────────────────────────────────────────────────── */
    let map: any = null;
    let marker: any = null;
    let customPin: any = null;

    function initMap() {
      if (map) return;

      const mapContainer = document.getElementById('address-map');
      if (!mapContainer) return;

      // Default to Bangkok center
      const defaultLatLng = [13.7563, 100.5018];

      // @ts-ignore
      if (typeof L === 'undefined') {
        console.error("Leaflet is not loaded yet.");
        return;
      }

      // @ts-ignore
      map = L.map('address-map', {
        zoomControl: true,
        attributionControl: false
      }).setView(defaultLatLng, 13);

      // @ts-ignore
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19
      }).addTo(map);

      // Custom pin design (Electric Violet themed, sharp diamond style)
      // @ts-ignore
      customPin = L.divIcon({
        className: 'custom-map-pin',
        html: `<div style="
          width: 16px; 
          height: 16px; 
          border: 2.5px solid var(--secondary); 
          background: var(--surface); 
          transform: rotate(45deg);
          display: flex; 
          align-items: center; 
          justify-content: center;
          box-shadow: 0 0 10px rgba(107, 56, 212, 0.6);
        ">
          <div style="width: 5px; height: 5px; background: var(--secondary);"></div>
        </div>`,
        iconSize: [24, 24],
        iconAnchor: [12, 12]
      });

      // Click on map to place pin and reverse-geocode
      map.on('click', async (e: any) => {
        const { lat, lng } = e.latlng;
        placeMarker(lat, lng);
        await reverseGeocode(lat, lng);
      });

      // Search button click handler
      const searchInput = document.getElementById('map-search-input') as HTMLInputElement;
      const searchBtn = document.getElementById('map-search-btn');

      const performSearch = async () => {
        const query = searchInput.value.trim();
        if (!query) return;

        try {
          const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`);
          const results = await res.json();
          if (results && results.length > 0) {
            const { lat, lon } = results[0];
            const latFloat = parseFloat(lat);
            const lngFloat = parseFloat(lon);

            map.setView([latFloat, lngFloat], 16);
            placeMarker(latFloat, lngFloat);
            await reverseGeocode(latFloat, lngFloat);
          } else {
            showToast("Location not found", "info");
          }
        } catch (err) {
          console.error("Geocoding search failed:", err);
        }
      };

      searchBtn?.addEventListener('click', performSearch);
      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          performSearch();
        }
      });

      // Try geolocating user's position initially
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition((pos) => {
          const { latitude, longitude } = pos.coords;
          map.setView([latitude, longitude], 15);
          if (!marker) {
            placeMarker(latitude, longitude);
            reverseGeocode(latitude, longitude);
          }
        }, () => {
          // ignore, stay at default
        });
      }
    }

    function placeMarker(lat: number, lng: number) {
      if (!map) return;
      if (marker) {
        marker.setLatLng([lat, lng]);
      } else {
        // @ts-ignore
        marker = L.marker([lat, lng], { icon: customPin, draggable: true }).addTo(map);
        
        // Handle dragging behavior
        marker.on('dragend', async (event: any) => {
          const position = event.target.getLatLng();
          await reverseGeocode(position.lat, position.lng);
        });
      }
    }

    function getShortAddressName(item: any): string {
      const addr = item.address || {};
      if (item.name) return item.name;
      
      const parts = [
        addr.house_number,
        addr.road || addr.pedestrian || addr.suburb || addr.neighbourhood
      ].filter(Boolean);
      
      if (parts.length > 0) return parts.join(' ');
      return item.display_name.split(',')[0] || 'Unknown Place';
    }

    function autofillFormFromAddress(addr: any, displayName?: string) {
      if (!addr) return;
      const form = document.getElementById('address-form') as HTMLFormElement;
      if (!form) return;

      const road = addr.road || addr.suburb || addr.neighbourhood || '';
      const houseNumber = addr.house_number || '';
      const address1 = [houseNumber, road].filter(Boolean).join(' ') || displayName || '';

      const city = addr.city || addr.town || addr.municipality || addr.state_district || '';
      const province = addr.state || addr.province || addr.region || '';
      const postalCode = addr.postcode || '';
      const countryCode = (addr.country_code || '').toUpperCase();

      // Fill inputs
      (form.querySelector('[name=address_1]') as HTMLInputElement).value = address1;
      (form.querySelector('[name=city]') as HTMLInputElement).value = city;
      (form.querySelector('[name=province]') as HTMLInputElement).value = province;
      (form.querySelector('[name=postal_code]') as HTMLInputElement).value = postalCode;
      (form.querySelector('[name=country_code]') as HTMLInputElement).value = countryCode;
    }

    async function fetchNearbySuggestions(lat: number, lng: number) {
      const suggestionsContainer = document.getElementById('map-suggestions');
      if (!suggestionsContainer) return;

      suggestionsContainer.innerHTML = '<p class="font-data-label text-[10px] text-[var(--outline)] tracking-widest uppercase animate-pulse py-1">Searching nearby...</p>';

      try {
        const delta = 0.003;
        const minLat = lat - delta;
        const maxLat = lat + delta;
        const minLng = lng - delta;
        const maxLng = lng + delta;

        const queryUrl = `https://nominatim.openstreetmap.org/search?format=json&q=shop,cafe,restaurant,building,highway,tourism&viewbox=${minLng},${maxLat},${maxLng},${minLat}&bounded=1&limit=6&addressdetails=1`;
        const res = await fetch(queryUrl);
        const results = await res.json();

        if (results && results.length > 0) {
          suggestionsContainer.innerHTML = '';
          
          const seen = new Set();
          const uniqueResults = results.filter((item: any) => {
            const shortName = getShortAddressName(item);
            if (!shortName || seen.has(shortName)) return false;
            seen.add(shortName);
            return true;
          }).slice(0, 5);

          if (uniqueResults.length === 0) {
            suggestionsContainer.innerHTML = '<p class="font-caption text-[10px] text-[var(--on-surface-variant)]/50 italic py-1">No local suggestions found.</p>';
            return;
          }

          uniqueResults.forEach((item: any) => {
            const shortName = getShortAddressName(item);
            const fullAddress = item.display_name;
            const itemLat = parseFloat(item.lat);
            const itemLng = parseFloat(item.lon);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'w-full text-left p-2 border border-[var(--outline-variant)]/20 hover:border-[var(--secondary)] hover:bg-[var(--secondary)]/5 transition-all text-xs flex flex-col gap-0.5 group cursor-pointer';
            btn.style.borderRadius = '0px';
            btn.innerHTML = `
              <span class="font-body-md text-xs font-semibold text-[var(--primary)] group-hover:text-[var(--secondary)] transition-colors">${shortName}</span>
              <span class="font-caption text-[10px] text-[var(--on-surface-variant)] truncate w-full">${fullAddress}</span>
            `;

            btn.addEventListener('click', () => {
              if (map) {
                map.setView([itemLat, itemLng], 17);
              }
              placeMarker(itemLat, itemLng);
              autofillFormFromAddress(item.address, item.name || shortName);
              showToast("Suggestion selected", "success");
            });

            suggestionsContainer.appendChild(btn);
          });
        } else {
          suggestionsContainer.innerHTML = '<p class="font-caption text-[10px] text-[var(--on-surface-variant)]/50 italic py-1">No local suggestions found.</p>';
        }
      } catch (err) {
        console.error("Failed to fetch suggestions:", err);
        suggestionsContainer.innerHTML = '<p class="font-caption text-[10px] text-[var(--error)] italic py-1">Failed to load suggestions.</p>';
      }
    }

    async function reverseGeocode(lat: number, lng: number) {
      const loader = document.getElementById('map-loading-overlay');
      loader?.classList.remove('hidden');

      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`);
        const data = await res.json();

        if (data && data.address) {
          autofillFormFromAddress(data.address, data.name || '');
          showToast("Address loaded from map", "success");
        }
        
        await fetchNearbySuggestions(lat, lng);
      } catch (err) {
        console.error("Reverse geocoding request failed:", err);
      } finally {
        loader?.classList.add('hidden');
      }
    }

    function openAddressModal(addr?: any) {
      const modal  = document.getElementById('address-modal')!;
      const title  = document.getElementById('address-modal-title')!;
      const form   = document.getElementById('address-form') as HTMLFormElement;

      title.textContent = addr ? 'Edit Address' : 'New Address';
      form.reset();

      // Reset search input
      const searchInput = document.getElementById('map-search-input') as HTMLInputElement;
      if (searchInput) searchInput.value = '';

      if (addr) {
        ['first_name','last_name','address_1','address_2','city','province','postal_code','country_code'].forEach(field => {
          const input = form.querySelector<HTMLInputElement>(`[name=${field}]`);
          if (input) input.value = addr[field] || '';
        });
        (form.querySelector('[name=is_default]') as HTMLInputElement).checked = !!(addr.is_default_billing || addr.metadata?.is_default);
        (form.querySelector('[name=address_id]') as HTMLInputElement).value = addr.id;
      }

      modal.classList.remove('hidden');

      // Initialize map & size correction
      initMap();
      setTimeout(() => {
        if (map) {
          map.invalidateSize();
          
          // Geocode existing address if editing
          if (addr && addr.address_1 && addr.city) {
            const query = `${addr.address_1}, ${addr.city}, ${addr.province || ''}, ${addr.country_code || ''}`;
            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`)
              .then(res => res.json())
              .then(results => {
                if (results && results.length > 0 && map) {
                  const { lat, lon } = results[0];
                  const latFloat = parseFloat(lat);
                  const lngFloat = parseFloat(lon);
                  map.setView([latFloat, lngFloat], 16);
                  placeMarker(latFloat, lngFloat);
                  fetchNearbySuggestions(latFloat, lngFloat);
                }
              }).catch(err => console.error("Initial address geocoding failed:", err));
          } else {
            // Clear previous marker for new address
            if (marker) {
              map.removeLayer(marker);
              marker = null;
            }
            // Clear suggestions list
            const suggestionsContainer = document.getElementById('map-suggestions');
            if (suggestionsContainer) {
              suggestionsContainer.innerHTML = '<p class="font-caption text-[10px] text-[var(--on-surface-variant)]/50 italic">Click/search on the map to see suggestions...</p>';
            }
          }
        }
      }, 200);
    }

