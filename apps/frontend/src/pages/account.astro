      <div id="orders-list" class="space-y-4">
        <!-- Skeleton placeholders -->
        <div class="order-skeleton border border-[var(--outline-variant)]/30 p-6 shimmer h-24"></div>
        <div class="order-skeleton border border-[var(--outline-variant)]/30 p-6 shimmer h-24"></div>
        <div class="order-skeleton border border-[var(--outline-variant)]/30 p-6 shimmer h-24"></div>
      </div>

      <div id="orders-empty" class="hidden py-16 flex flex-col items-center gap-4 border border-dashed border-[var(--outline-variant)] text-center">
        <span class="material-symbols-outlined text-[var(--outline-variant)]" style="font-size:40px;">inventory</span>
        <p class="font-data-label text-xs text-[var(--outline)] uppercase tracking-widest">No orders found</p>
        <a href="/shop" class="font-caption text-[11px] text-[var(--secondary)] hover:underline underline-offset-2 no-underline">Browse the Shop →</a>
