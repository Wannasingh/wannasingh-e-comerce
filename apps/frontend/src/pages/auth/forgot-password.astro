---
// src/pages/auth/forgot-password.astro — Recovery Protocol | AETHER
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="WANNASINGH | Reset Password"
  description="Reset your password and regain access to your account."
>
  <div class="relative min-h-[calc(100vh-80px)] flex items-center justify-center py-16 px-4 md:px-16 overflow-hidden">
    <div class="absolute inset-0 tech-grid opacity-10 pointer-events-none"></div>
    <div
      class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[600px] h-[600px] pointer-events-none"
      style="background: radial-gradient(circle, rgba(107,56,212,0.06), transparent 70%); filter: blur(60px);"
    ></div>

    <div class="w-full max-w-md z-10 border border-[var(--outline-variant)] bg-[var(--surface-container-lowest)] p-10 md:p-14 relative overflow-hidden">
      <div class="auth-scanline"></div>

      <!-- Back link -->
      <a href="/auth" class="inline-flex items-center gap-2 font-data-label text-[10px] text-[var(--on-surface-variant)] hover:text-[var(--secondary)] uppercase tracking-widest mb-10 no-underline transition-colors group">
        <span class="material-symbols-outlined transition-transform group-hover:-translate-x-1" style="font-size: 14px;">arrow_back</span>
        Back to Sign In
      </a>

      <!-- Header -->
      <div class="mb-10">
        <div class="inline-flex items-center gap-2 border border-[var(--secondary)]/30 px-3 py-1.5 mb-6">
          <span class="w-1.5 h-1.5 bg-[var(--secondary)] animate-pulse"></span>
          <span class="font-caption text-xs tracking-widest uppercase text-[var(--secondary)] font-semibold">Reset Password</span>
        </div>
        <h1 class="font-headline-md text-2xl uppercase tracking-tight mb-2">Reset Password</h1>
        <p class="font-caption text-[11px] text-[var(--on-surface-variant)]">
          Enter your email address. If an account exists, we'll send a password reset link to your inbox.
        </p>
      </div>

      <!-- Success state -->
      <div id="recovery-success" class="hidden mb-8">
        <div class="border border-[var(--secondary)]/30 bg-[var(--secondary)]/5 p-6 flex items-start gap-4">
          <span class="material-symbols-outlined text-[var(--secondary)] mt-0.5" style="font-size: 20px;">mark_email_read</span>
          <div>
            <p class="font-data-label text-xs text-[var(--secondary)] uppercase tracking-wider mb-1">Reset Link Sent</p>
            <p class="font-caption text-[11px] text-[var(--on-surface-variant)]">Check your email for instructions to reset your password. The link expires in 30 minutes.</p>
          </div>
        </div>
        <a href="/auth" class="block mt-6 text-center font-data-label text-[11px] text-[var(--secondary)] hover:underline underline-offset-2 no-underline">
          Return to Sign In →
        </a>
      </div>

      <!-- Form -->
      <form id="recovery-form" class="space-y-6" novalidate>
        <div class="field-group">
          <label for="recovery-email" class="field-label font-caption text-xs text-[var(--outline)] uppercase tracking-wider block mb-1">
            Email Address
          </label>
          <div class="relative border-b border-[var(--outline-variant)] pb-1">
            <input
              id="recovery-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="your@email.com"
              class="field-input w-full bg-transparent border-none font-body-md text-sm py-2 px-0 placeholder:text-[var(--outline-variant)]/40 focus:outline-none"
            />
          </div>
          <p class="field-error font-caption text-[10px] text-[var(--error)] mt-1 hidden"></p>
        </div>

        <button
          type="submit"
          class="w-full bg-[var(--primary)] text-[var(--on-primary)] py-5 font-data-label text-xs tracking-[0.2em] hover:bg-[var(--secondary)] transition-all flex justify-between items-center px-8 group cursor-pointer"
        >
          <span class="btn-label">SEND RESET LINK</span>
          <span class="btn-loader hidden">
            <span class="inline-flex gap-1">
              <span class="w-1 h-1 bg-white animate-bounce" style="animation-delay: 0ms;"></span>
              <span class="w-1 h-1 bg-white animate-bounce" style="animation-delay: 150ms;"></span>
              <span class="w-1 h-1 bg-white animate-bounce" style="animation-delay: 300ms;"></span>
            </span>
          </span>
          <span class="material-symbols-outlined transition-transform group-hover:translate-x-2" style="font-size: 20px;">send</span>
        </button>

        <p id="recovery-error" class="font-caption text-[11px] text-[var(--error)] text-center hidden"></p>
      </form>
    </div>
  </div>

  <style>
    .tech-grid {
      background-image: radial-gradient(circle, var(--outline-variant) 1px, transparent 1px);
      background-size: 40px 40px;
    }
    .auth-scanline {
      width: 100%;
      height: 2px;
      background: linear-gradient(to right, transparent, var(--secondary), transparent);
      position: absolute;
      top: 0;
      left: 0;
      animation: auth-scan 6s linear infinite;
      opacity: 0.2;
      z-index: 20;
      pointer-events: none;
    }
    @keyframes auth-scan {
      0%   { top: 0%;   opacity: 0; }
      10%  { opacity: 0.25; }
      90%  { opacity: 0.25; }
      100% { top: 100%; opacity: 0; }
    }
  </style>

  <script>
    const API = (import.meta.env.PUBLIC_MEDUSA_BACKEND_URL as string) || 'http://localhost:9000';
    const PK  = (import.meta.env.PUBLIC_MEDUSA_PUBLISHABLE_KEY as string) || '';

    // Field focus effects
    document.querySelectorAll<HTMLInputElement>('.field-input').forEach(input => {
      const group  = input.closest('.field-group')!;
      const border = input.closest('.relative')!;
      const label  = group?.querySelector<HTMLElement>('.field-label');
      input.addEventListener('focus', () => {
        (border as HTMLElement).style.borderColor = 'var(--secondary)';
        if (label) label.style.color = 'var(--secondary)';
      });
      input.addEventListener('blur', () => {
        (border as HTMLElement).style.borderColor = '';
        if (label) label.style.color = '';
      });
    });

    const form      = document.getElementById('recovery-form') as HTMLFormElement;
    const successEl = document.getElementById('recovery-success')!;
    const errorEl   = document.getElementById('recovery-error')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector<HTMLInputElement>('[name=email]')!;
      const errField   = emailInput.closest('.field-group')!.querySelector<HTMLElement>('.field-error')!;
      const btn        = form.querySelector<HTMLButtonElement>('[type=submit]')!;
      const label      = btn.querySelector<HTMLElement>('.btn-label')!;
      const loader     = btn.querySelector<HTMLElement>('.btn-loader')!;

      errField.classList.add('hidden');
      errorEl.classList.add('hidden');

      if (!emailInput.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
        errField.textContent = 'Valid email required';
        errField.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      label.classList.add('hidden');
      loader.classList.remove('hidden');

      try {
        // Medusa reset password request
        await fetch(`${API}/auth/customer/emailpass/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-publishable-api-key': PK },
          body: JSON.stringify({ identifier: emailInput.value }),
        });
        // Always show success (don't leak user existence)
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
      } catch {
        // Show success anyway to prevent user enumeration
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
      }
    });
  </script>
</Layout>
