---
// src/pages/careers.astro — Careers / Sector Recruitment | AETHER Cyber-Minimalism
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="AETHER | SECTOR RECRUITMENT"
  description="Join Wannasingh Performance Systems research labs. Seek new structural challenges."
>
  <div class="py-20 px-6 md:px-16 max-w-[800px] mx-auto reveal space-y-12">
    <header class="border-b border-[var(--outline-variant)]/30 pb-6">
      <p class="font-data-label text-xs text-[var(--secondary)] uppercase tracking-[0.2em]">
        SECTOR RECRUITMENT / ENROLLMENT
      </p>
      <h1 class="font-display text-4xl text-[var(--primary)] uppercase leading-none mt-1">
        Careers
      </h1>
      <p class="font-data-value text-xs text-[var(--outline)] mt-2">
        ACTIVE ROLES: 03 // LAB_LOC: STRETCH_SEC_07
      </p>
    </header>

    <div class="space-y-8 font-body-md text-sm text-[var(--on-surface-variant)] leading-relaxed">
      <section class="space-y-3">
        <h2 class="font-data-label text-xs uppercase text-[var(--primary)] font-bold">
          01. Materials Engineer (Polymer Science)
        </h2>
        <p>
          Develop compostable bio-recovered nylon structures and thermal barrier fibers. Calibrated
          for sub-zero environmental stress tolerances.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="font-data-label text-xs uppercase text-[var(--primary)] font-bold">
          02. Seam Welding Specialist (Kinetic Labs)
        </h2>
        <p>
          Execute laser-sealing and seam tape welding protocols on lightweight hardshell prototypes.
          Focuses on pressure integrity limits.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="font-data-label text-xs uppercase text-[var(--primary)] font-bold">
          03. Interface Designer (HUD Systems)
        </h2>
        <p>
          Design telemetry displays and mobile dashboard controls for operative apparel NFC chips.
          Cyber-minimalist aesthetics mandatory.
        </p>
      </section>
    </div>
  </div>
</Layout>
