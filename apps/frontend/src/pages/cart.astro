---
// src/pages/cart.astro — Shopping Bag | AETHER Cyber-Minimalist Design
import Layout from "../layouts/Layout.astro";
---

<Layout title="YOUR BAG | WANNASINGH PERFORMANCE SYSTEMS" description="Review items in your active bag before deploying to secure checkout.">
  <div class="py-12 px-6 md:px-16 max-w-[1440px] mx-auto">

    <!-- Cart Header -->
    <header class="relative mb-12 border-b border-outline-variant/30 pb-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="font-data-label text-xs text-secondary uppercase tracking-[0.2em]">Active Inventory / Bag</p>
          <h1 class="font-display text-4xl text-primary uppercase leading-none mt-1">Your Bag</h1>
        </div>
        <span class="font-data-label text-xs tracking-wider text-on-surface-variant" id="cart-item-count">
          [ 00 ITEMS ]
        </span>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">

      <!-- Left Column: Cart Items (rendered by JS) -->
      <div class="lg:col-span-8">

        <!-- Empty state -->
        <div id="empty-state" class="hidden text-center py-20 border border-dashed border-outline-variant">
          <span class="material-symbols-outlined text-outline" style="font-size: 48px;">shopping_bag</span>
          <p class="font-data-label text-xs uppercase tracking-widest text-on-surface-variant mt-4">Your bag is currently empty.</p>
          <a
            href="/shop"
            class="inline-block mt-8 bg-primary text-on-primary px-8 py-4 font-data-label text-xs tracking-widest hover:bg-secondary transition-all no-underline"
          >
            BROWSE COLLECTION
          </a>
        </div>

        <!-- Items list -->
        <div id="items-list" class="space-y-8"></div>

      </div>

      <!-- Right Column: Order Summary -->
      <div class="lg:col-span-4 bg-surface-container-low p-8 border border-outline-variant/30 sticky top-28">
        <h2 class="font-data-label text-sm uppercase mb-8 pb-4 border-b border-outline-variant tracking-widest text-primary">
          Summary
        </h2>

        <div class="space-y-4 mb-8">
          <div class="flex justify-between font-data-label text-xs">
            <span class="text-on-surface-variant">SUBTOTAL</span>
            <span class="text-primary" id="summary-subtotal">$0.00</span>
          </div>
          <div class="flex justify-between font-data-label text-xs">
            <span class="text-on-surface-variant">SHIPPING</span>
            <span class="text-secondary">FREE</span>
          </div>
          <div class="flex justify-between font-headline-md text-lg font-bold pt-4 border-t border-outline-variant/30">
            <span class="text-primary">TOTAL</span>
            <span class="text-primary" id="summary-total">$0.00</span>
          </div>
        </div>

        <div class="space-y-3">
          <a
            href="/checkout"
            class="block w-full bg-primary text-on-primary py-5 font-data-label text-xs tracking-[0.2em] hover:bg-secondary transition-colors text-center no-underline uppercase"
          >
            PROCEED TO CHECKOUT
          </a>
          <a
            href="/shop"
            class="block w-full border border-outline-variant text-on-surface-variant py-4 font-caption text-xs uppercase hover:text-primary hover:border-primary transition-colors text-center no-underline"
          >
            CONTINUE SHOPPING
          </a>
        </div>

        <div class="mt-8 flex items-start space-x-3 text-on-surface-variant">
          <span class="material-symbols-outlined" style="font-size: 18px;">lock</span>
          <p class="font-caption text-[11px] leading-relaxed">
            Biometric credentials and network secure protocols active. All transactions are encrypted.
          </p>
        </div>
      </div>

    </div>
  </div>

  <script>
    // ── Type ────────────────────────────────────────────────────────────────
    interface CartItem {
      id: string;
      name: string;
      price: string;
      size: string;
      qty: number;
      image?: string;
    }

    // ── DOM refs ─────────────────────────────────────────────────────────────
    const itemsList        = document.getElementById("items-list")       as HTMLElement;
    const emptyState       = document.getElementById("empty-state")      as HTMLElement;
    const cartItemCount    = document.getElementById("cart-item-count")  as HTMLElement;
    const summarySubtotal  = document.getElementById("summary-subtotal") as HTMLElement;
    const summaryTotal     = document.getElementById("summary-total")    as HTMLElement;
    const navBadge         = document.getElementById("cart-count")       as HTMLElement | null;

    // ── Helpers ──────────────────────────────────────────────────────────────
    function getCart(): CartItem[] {
      try { return JSON.parse(localStorage.getItem("wanna_cart") || "[]"); }
      catch { return []; }
    }

    function saveCart(cart: CartItem[]) {
      localStorage.setItem("wanna_cart", JSON.stringify(cart));
    }

    function parsePrice(p: string): number {
      return parseFloat(p.replace(/[^0-9.]/g, "")) || 0;
    }

    function formatPrice(n: number): string {
      return "$" + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    function syncNavBadge(total: number) {
      if (!navBadge) return;
      navBadge.textContent = String(total);
      navBadge.classList.toggle("hidden", total === 0);
    }

    // ── Render ───────────────────────────────────────────────────────────────
    function render() {
      const cart = getCart();
      itemsList.innerHTML = "";

      if (cart.length === 0) {
        emptyState.classList.remove("hidden");
        cartItemCount.textContent      = "[ 00 ITEMS ]";
        summarySubtotal.textContent    = "$0.00";
        summaryTotal.textContent       = "$0.00";
        syncNavBadge(0);
        return;
      }

      emptyState.classList.add("hidden");

      let subtotal = 0;
      let totalQty = 0;

      cart.forEach((item, idx) => {
        const unitPrice = parsePrice(item.price);
        subtotal += unitPrice * item.qty;
        totalQty += item.qty;

        const el = document.createElement("div");
        el.className = "flex flex-col sm:flex-row gap-6 border-b border-outline-variant/20 pb-8 group transition-all duration-300";
        el.dataset.idx = String(idx);

        // Image — use real product image if available, otherwise show placeholder icon
        const imgHtml = item.image
          ? `<img
               src="${item.image}"
               alt="${item.name}"
               class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
             />`
          : `<div class="w-full h-full flex items-center justify-center bg-surface-container-highest">
               <span class="material-symbols-outlined text-outline-variant" style="font-size:40px;">checkroom</span>
             </div>`;

        el.innerHTML = `
          <div class="w-32 h-40 bg-surface-container-high flex-shrink-0 overflow-hidden border border-outline-variant/20">
            ${imgHtml}
          </div>

          <div class="flex-grow flex flex-col justify-between py-1">
            <div class="flex justify-between items-start gap-4">
              <div>
                <h3 class="font-body-md text-lg font-bold uppercase tracking-tight text-primary">${item.name}</h3>
                <p class="font-data-label text-[10px] text-on-surface-variant mt-1">SIZE: ${item.size}</p>
              </div>
              <span class="font-data-value text-base text-primary font-semibold">${formatPrice(unitPrice)}</span>
            </div>

            <div class="flex justify-between items-center mt-6">
              <div class="flex items-center border border-outline-variant">
                <button type="button" class="btn-minus px-3 py-1.5 font-data-label text-xs hover:bg-surface-container transition-colors cursor-pointer select-none">−</button>
                <span class="qty-display px-4 py-1.5 font-data-label text-xs text-primary border-x border-outline-variant bg-surface min-w-[40px] text-center">${item.qty}</span>
                <button type="button" class="btn-plus px-3 py-1.5 font-data-label text-xs hover:bg-surface-container transition-colors cursor-pointer select-none">+</button>
              </div>

              <span class="font-data-label text-xs text-secondary">${formatPrice(unitPrice * item.qty)}</span>

              <button type="button" class="btn-remove font-data-label text-xs text-on-surface-variant hover:text-error border-b border-transparent hover:border-error pb-0.5 transition-colors cursor-pointer">
                REMOVE
              </button>
            </div>
          </div>
        `;

        // Qty −
        el.querySelector(".btn-minus")!.addEventListener("click", async () => {
          const c = getCart();
          if (c[idx]) {
            if (c[idx].qty > 1) {
              c[idx].qty--;
              saveCart(c);
              render();
            } else {
              const confirmRemove = await (window as any).showAetherConfirm("Confirm Item Removal", `Are you sure you want to remove ${item.name} from your bag?`);
              if (confirmRemove) {
                el.style.opacity = "0";
                el.style.transform = "translateY(10px)";
                setTimeout(() => {
                  const newCart = getCart();
                  newCart.splice(idx, 1);
                  saveCart(newCart);
                  render();
                }, 280);
              }
            }
          }
        });

        // Qty +
        el.querySelector(".btn-plus")!.addEventListener("click", () => {
          const c = getCart();
          if (c[idx]) { c[idx].qty++; saveCart(c); render(); }
        });

        // Remove
        el.querySelector(".btn-remove")!.addEventListener("click", async () => {
          const confirmRemove = await (window as any).showAetherConfirm("Confirm Item Removal", `Are you sure you want to remove ${item.name} from your bag?`);
          if (!confirmRemove) return;

          el.style.opacity = "0";
          el.style.transform = "translateY(10px)";
          setTimeout(() => {
            const c = getCart();
            c.splice(idx, 1);
            saveCart(c);
            render();
          }, 280);
        });

        itemsList.appendChild(el);
      });

      // Update totals + header count
      cartItemCount.textContent   = `[ ${String(totalQty).padStart(2, "0")} ITEMS ]`;
      summarySubtotal.textContent = formatPrice(subtotal);
      summaryTotal.textContent    = formatPrice(subtotal);
      syncNavBadge(totalQty);
    }

    // Boot
    render();
  </script>
</Layout>
