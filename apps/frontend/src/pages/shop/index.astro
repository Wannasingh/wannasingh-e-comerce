const filterSections = [
  {
    title: "Technical Performance",
    id: "perf",
    options: [
      { label: "WATERPROOF", checked: false },
      { label: "WINDPROOF", checked: false },
      { label: "BREATHABLE", checked: true },
      { label: "INSULATED", checked: false },
    ],
  },
  {
    title: "Fabric Technology",
    id: "fabric",
    options: [
      { label: "GORE-TEX PRO", checked: false },
      { label: "DYNEEMA® BLEND", checked: false },
      { label: "3L CORDURA®", checked: false },
    ],
