---
// src/pages/shop/index.astro — Product listing page (SSR)
export const prerender = false;

import Layout from "@layouts/Layout.astro";

const title = "Shop — Wannasingh";
const description = "Explore our full collection of premium products.";

// Fetch products from Medusa backend (server-side)
let products: Record<string, unknown>[] = [];
let error: string | null = null;

try {
  const backendUrl = import.meta.env.PUBLIC_MEDUSA_BACKEND_URL ?? "http://localhost:9000";
  const publishableKey = import.meta.env.PUBLIC_MEDUSA_PUBLISHABLE_KEY ?? "";
  const res = await fetch(`${backendUrl}/store/products?limit=24`, {
    headers: { "x-publishable-api-key": publishableKey },
  });
  if (res.ok) {
    const data = (await res.json()) as { products: Record<string, unknown>[] };
    products = data.products ?? [];
  }
} catch {
  error = "Could not load products. Please try again later.";
}
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight">
        All <span class="gradient-text">Products</span>
      </h1>
      <p class="mt-2 text-muted-foreground">
        {products.length > 0 ? `${products.length} products` : "Explore our collection"}
      </p>
    </div>

    {
      error && (
        <div
          role="alert"
          class="rounded-xl border border-destructive/30 bg-destructive/10 p-6 mb-8"
        >
          <p class="text-sm text-destructive">{error}</p>
        </div>
      )
    }

    {
      products.length === 0 && !error && (
        <div
          class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"
          aria-label="Loading products"
        >
          {Array.from({ length: 8 }).map((_) => (
            <div class="rounded-2xl border overflow-hidden" aria-hidden="true">
              <div class="aspect-square shimmer" />
              <div class="p-4 space-y-2">
                <div class="h-4 w-3/4 rounded shimmer" />
                <div class="h-3 w-1/2 rounded shimmer" />
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      products.length > 0 && (
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {products.map((product, i) => (
            <a
              id={`product-card-${String(product["id"] ?? i)}`}
              href={`/products/${String(product["handle"] ?? "")}`}
              class="group rounded-2xl border overflow-hidden glass hover:border-[hsl(262,78%,53%)] hover:shadow-lg transition-all duration-300 animate-fade-in"
              style={`animation-delay: ${i * 50}ms`}
            >
              <div class="aspect-square bg-muted overflow-hidden">
                {product["thumbnail"] ? (
                  <img
                    src={String(product["thumbnail"])}
                    alt={String(product["title"] ?? "Product")}
                    width={400}
                    height={400}
                    loading={i < 4 ? "eager" : "lazy"}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-muted-foreground">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="40"
                      height="40"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      aria-hidden="true"
                    >
                      <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                      <circle cx="9" cy="9" r="2" />
                      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-4">
                <h2 class="font-medium text-sm line-clamp-2 group-hover:text-[hsl(262,78%,63%)] transition-colors">
                  {String(product["title"] ?? "Untitled Product")}
                </h2>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>
