---

<Layout title={siteTitle} description={siteDescription}>
  <main class="pt-12 pb-24 container-aether">
    <!-- ── Page Header ───────────────────────────────────────────────────── -->
    <header class="mb-14">
      <h1
        class="font-display text-[var(--primary)] uppercase mb-4"
        style="font-size: clamp(36px, 5vw, 56px); letter-spacing: -0.03em;"
      >
        Outerwear
      </h1>
      <div
        class="flex flex-col md:flex-row md:justify-between md:items-end pb-6 gap-4"
        style="border-bottom: 1px solid rgba(196,199,199,0.35);"
      >
        <p class="font-body-lg text-[var(--on-surface-variant)] max-w-2xl" style="font-size: 16px;">
          Engineered for extreme performance. Our outerwear collection fuses technical tactical utility with
          minimalist aesthetic precision.
        </p>
        <div class="flex items-center gap-5 shrink-0">
          <span class="font-data-label text-[var(--outline)]" style="font-size: 11px;">
            RESULTS [{products.length}]
          </span>
          <button
            id="sort-toggle"
            class="font-data-label text-[var(--primary)] hover:text-[var(--secondary)] transition-colors"
            style="font-size: 11px;"
          >
            SORT: NEWEST ↕
          </button>
        </div>
      </div>
    </header>

    <!-- ── Layout: Sidebar + Grid ────────────────────────────────────────── -->
    <div class="flex flex-col md:flex-row gap-12">

      <!-- Sidebar Filter -->
      <aside class="w-full md:w-60 shrink-0" aria-label="Product filters">
        <div class="sticky top-28 space-y-10">
          {filterSections.map((section) => (
            <section aria-labelledby={`filter-${section.id}`}>
              <h3
                id={`filter-${section.id}`}
                class="font-data-label text-[var(--primary)] mb-5 tracking-widest"
                style="font-size: 11px;"
              >
                {section.title}
              </h3>
              <div class="space-y-3">
                {section.options.map((opt) => (
                  <label class="flex items-center gap-3 group cursor-pointer">
                    <input
                      type="checkbox"
                      checked={opt.checked}
                      class="w-4 h-4 border-[var(--outline)] accent-[var(--secondary)] cursor-pointer"
                      style="border-radius: 0px !important;"
                    />
                    <span
                      class={`font-data-label transition-colors ${
                        opt.checked
                          ? "text-[var(--primary)]"
                          : "text-[var(--on-surface-variant)] group-hover:text-[var(--primary)]"
                      }`}
                      style="font-size: 11px;"
                    >
                      {opt.label}
                    </span>
                  </label>
                ))}
              </div>
            </section>
          ))}

          <!-- Price Range -->
          <section aria-labelledby="filter-price">
            <h3
              id="filter-price"
              class="font-data-label text-[var(--primary)] mb-5 tracking-widest"
              style="font-size: 11px;"
            >
              Price Range
            </h3>
            <input
              type="range"
              min="200"
              max="1200"
              value="1200"
              id="price-range"
              class="w-full h-px cursor-pointer accent-[var(--primary)]"
              aria-label="Maximum price"
            />
            <div class="flex justify-between mt-3">
              <span class="font-data-label text-[var(--on-surface-variant)]" style="font-size: 11px;">$200</span>
              <span id="price-max-label" class="font-data-label text-[var(--on-surface-variant)]" style="font-size: 11px;">$1,200</span>
            </div>
          </section>
        </div>
      </aside>

      <!-- Product Grid -->
      <div
        class="flex-1 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-6 gap-y-14"
        aria-label="Products"
        role="list"
      >
        {products.map((product) => (
          <a
            href={product.href}
            id={`product-${product.id}`}
            class="group cursor-pointer no-underline reveal"
            role="listitem"
            aria-label={`${product.name} — ${product.price}`}
          >
            <!-- Image + specs overlay -->
            <div class="relative aspect-[3/4] mb-5 overflow-hidden bg-[var(--surface-container-low)]">
              <img
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                src={product.image}
                alt={product.imageAlt}
                loading="lazy"
                width="600"
                height="800"
              />

              <!-- Hover specs overlay -->
              <div
                class="absolute inset-0 bg-[var(--primary)] opacity-0 group-hover:opacity-95
                       transition-opacity duration-300 p-8 flex flex-col justify-end"
                aria-hidden="true"
              >
                <div class="space-y-5">
                  <h4 class="font-data-label text-[var(--on-primary)] tracking-widest" style="font-size: 11px;">
                    TECHNICAL SPECIFICATIONS
                  </h4>
                  <div
                    class="grid grid-cols-2 gap-4 pt-4"
                    style="border-top: 1px solid rgba(255,255,255,0.15);"
                  >
                    {product.specs.map((spec) => (
                      <div>
                        <span class="block font-caption text-[var(--on-primary-container)] uppercase mb-1" style="font-size: 10px;">
                          {spec.label}
                        </span>
                        <span class="font-data-value text-[var(--on-primary)]" style="font-size: 12px;">
                          {spec.value}
                        </span>
                      </div>
                    ))}
                  </div>
                  <div
                    class="w-full py-4 bg-[var(--on-primary)] text-[var(--primary)]
                           font-data-label text-center hover:bg-[var(--secondary)] hover:text-[var(--on-secondary)]
                           transition-colors duration-300"
                    style="font-size: 11px; letter-spacing: 0.1em;"
                  >
                    VIEW FULL SPECS
                  </div>
                </div>
              </div>
            </div>

            <!-- Product info -->
            <div class="flex justify-between items-start gap-4">
              <div>
                <h2
                  class="font-headline-md text-[var(--primary)] mb-1 uppercase"
                  style="font-size: 16px; font-weight: 700;"
                >
                  {product.name}
                </h2>
                <p class="font-data-label text-[var(--on-surface-variant)] uppercase" style="font-size: 10px;">
                  {product.subtitle}
                </p>
              </div>
              <span class="font-data-value text-[var(--primary)] shrink-0" style="font-size: 15px;">
                {product.price}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  // Price range label sync
  const range = document.getElementById("price-range") as HTMLInputElement | null;
  const label = document.getElementById("price-max-label");
  range?.addEventListener("input", () => {
    if (label) label.textContent = `$${Number(range.value).toLocaleString()}`;
  });
</script>
