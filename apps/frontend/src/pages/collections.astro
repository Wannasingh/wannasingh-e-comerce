---
// src/pages/collections.astro — Collections Archive | AETHER Cyber-Minimalism

import Layout from "../layouts/Layout.astro";
import { getCachedProducts } from "../lib/cache";

interface CollectionsProduct {
  metadata?: {
    category?: string;
  };
}

// Fetch total product count from API
let totalProducts = 0;
let categoryMap: Record<string, number> = {};

try {
  const products = (await getCachedProducts()) as CollectionsProduct[];
  if (products.length > 0) {
    totalProducts = products.length;
    // Count by category from metadata
    for (const p of products) {
      const cat = p.metadata?.category || "Outerwear";
      categoryMap[cat] = (categoryMap[cat] || 0) + 1;
    }
  }
} catch (err) {
  console.error("Failed to fetch product counts:", err);
}

const IMG = [
  "https://lh3.googleusercontent.com/aida-public/AB6AXuCHFF-Askr-UVEcPxEatG03-NYhria9d1LD89xkSFRsysrpXIb0-XITMLvOob4NG48RStSeUZvnqE-b0SAZ_D2REoczbzNrn_ja6JX8qLfbj5o8EV8uKaT6I89igEyEsDyhTlKc6dWgEOQ1HbTdtwD9xmvaRM-i0Mm5qoW5Zuxpc6OnoQQ0lwxc5O-uaBl4Swcy_WU8x0_ODGNpMMMymEBBqmhJs2NFIfJm2Uhy7s0zGbBqDJxq7es5PhSa0Mv9snsLxe-_XFKGLYYG",
  "https://lh3.googleusercontent.com/aida-public/AB6AXuBEBLQdp0-1kvBJRQWQVsotyAdr4P1zLrLAVKcsx-BIevAhnAdUerqyhrHJEVOR3IW1QP2dJz8slM3XieNHLnPAoUe51ZIsYmmFZJQP688RNtK9vDwoN1N3GAvnnD5nYbzw23y8q86DXbbNGskNIiqfTEPBF8XXrraJA5vGKX3GQpm2SXP9MxsxzcQHMCUPwKbwhPBFvh6LytQFapNXZP4dwhhvz1uHoZF5gwtlqeG2eLuNi_YK9ax-jOpJVehlejDYroY3GcCKMWBE",
  "https://lh3.googleusercontent.com/aida-public/AB6AXuD6WTv34VitQexJJiT16v3SRk4xSCov8gxQeKuWZie-PLPsI9Tu64Nkdi7iEMqfDzKkhxs7vzhHFhW-wYyyAWfTMEBjzaJoneGu4B23eNKXbsOElwykRDijdKkaurib1Z0XkvpTYG2_3EnlTRS2g0M3qQkVPvhlGLr4bIS1CHnF6uGb0f3GlD8qU71JXyAlLlIZt9B0qTb_VSDQ9gSgXYKCnvOPA5EizjNVKun6f5NROmNmyJTNbPqpoBmnCx6OXSAji-vXYeD7iQsi",
  "https://lh3.googleusercontent.com/aida-public/AB6AXuDj080BlpX9quuEZyPbBXuZEqJDkjGgGUBCygUBm8ypVpA5Q1_nzyg_8l2797PWXxaDOtZCj_p629ugTX1E9AdKClIvOM0OPz4P3CpWNCBdGXF8hsh8x0OwCLbBcfbCXeiDb3H18laq7N1iduNdarS8TczvXcgQcQXsMSrjg0hGl935Pd_Nv8rjWCEJQMRYd9GC2KqsmojDBfUMMmqLn2QRQkMUmvYvMSLQaWKDj604VVK6WgZID6nRG_Bsllqd42kyWT-dux0wNxk3",
  "https://lh3.googleusercontent.com/aida-public/AB6AXuAduJI42AxGAa90CHHC917vkMZm6rmcX8SxqcFulA-bnXj9reWIBbwdxWLlKI9LrKzAhbxkaIDkB2JcR0ahWI4WmNPBtOkrYPNO1S5Wp0uePYMkRPf9XrzXtQteKZ2CpZifA4_RaQ19ycGm_8t8Ha5ZJUM_UXtNhNOUs18uMxb8yaa9SLWx-5w77E-sfbaKyj3721IX9qMvBoUEtuu9w-rYLW9gxudF7jCDFGDzKsZbLM4BRaQmXMsNEdahBB07uYWatnrB4HVIbMX0",
  "https://lh3.googleusercontent.com/aida-public/AB6AXuB6o8eGNrsnN_Cw93q55oLygXOH8w1eidswoGyRCQBEl5GHo3ZEW7uKaSNy_2gsWNaR5ujpA2_jioVBpNjmEin6uQndXi0TinPTsbDXAz0kPYV-aVOLgv91JGCvZNzZiqwaaALW8mai_5-pgdeya82DJs4kfnlsSFSyTs3BGGCY-HlmLihMCyWtKu1k03iU51LV0hexj4nx6oz3SOCXS9uEj3BBEtwrs_yWse0RFen87QoS_uRObyMYqnAKnxy2ov8gbRPWygb8OwGL",
  "https://lh3.googleusercontent.com/aida-public/AB6AXuD5j6wILASNWIJgj1ANFebyww1VgywHS8WLxTA4QIG3Psj4N-BPZkozhZRL9aIUfNNpeKB_4jkE43hFkyARpZWvODhEPGUgkq7xbC7WFd3FwKMp_MB3LHb8_oRUAI5Tjhdqeaot2F0uN_lrZwiQZGlEOAX0xjPAYenKCjf5MHO6aMa2hszyFRiYRJlqzNUpyHSiU7UbeNf_r8GdkMeXoioBgHfRd4F9xuof-Xmm9XfUY5Fd-_rTqLwKxInV667-SIJGoxKpGNdYkuBb",
];

// Build collections from actual product categories
const categoryDescriptions: Record<
  string,
  { title: string; desc: string; status: string; statusColor: string }
> = {
  Outerwear: {
    title: "OUTERWEAR // SHELL SYSTEMS",
    desc: "Engineered for high-stakes urban navigation and extreme environmental adaptability. Features modular shell structures, waterproof membranes, and wind-barrier technologies.",
    status: "ACTIVE OPERATIONAL",
    statusColor: "var(--secondary)",
  },
  "Mid-Layer": {
    title: "MID-LAYERS // THERMAL CORE",
    desc: "Active insulation and thermal regulation systems. From PrimaLoft hybrid construction to Polartec stretch fleece, calibrated for dynamic temperature management.",
    status: "ACTIVE OPERATIONAL",
    statusColor: "var(--secondary)",
  },
  Bottoms: {
    title: "BOTTOMS // MOBILITY SYSTEM",
    desc: "Articulated tactical trousers and technical joggers. Ripstop construction with reinforced knee panels and modular pocket architecture.",
    status: "ACTIVE OPERATIONAL",
    statusColor: "var(--secondary)",
  },
  "Base Layer": {
    title: "BASE LAYERS // CORE SYSTEM",
    desc: "Next-to-skin performance fabrics. Merino blends and synthetic moisture-management systems for temperature regulation and odor control.",
    status: "ACTIVE OPERATIONAL",
    statusColor: "var(--secondary)",
  },
  Accessories: {
    title: "ACCESSORIES // UTILITY MODULES",
    desc: "Tactical utility accessories from balaclavas to chest rigs. MOLLE-compatible, weather-sealed, and built from military-specification materials.",
    status: "ACTIVE OPERATIONAL",
    statusColor: "var(--secondary)",
  },
  Vests: {
    title: "VESTS // CARRY SYSTEMS",
    desc: "Modular load-carry architecture. Tactical chest rigs and utility vests with multi-point MOLLE attachment systems and ergonomic harness geometry.",
    status: "ACTIVE OPERATIONAL",
    statusColor: "var(--secondary)",
  },
  Footwear: {
    title: "FOOTWEAR // GROUND SYSTEM",
    desc: "Technical footwear engineered for all-terrain performance. GORE-TEX linings, Vibram outsoles, and reinforced toe protection.",
    status: "ACTIVE OPERATIONAL",
    statusColor: "var(--secondary)",
  },
};

const collections = Object.entries(categoryMap)
  .sort((a, b) => b[1] - a[1])
  .map(([cat, count], i) => {
    const info = categoryDescriptions[cat] || {
      title: `${cat.toUpperCase()} // SYSTEM`,
      desc: `High-performance ${cat.toLowerCase()} collection.`,
      status: "ACTIVE",
      statusColor: "var(--secondary)",
    };
    return {
      id: cat.toLowerCase().replace(/\s+/g, "-"),
      title: info.title,
      status: info.status,
      statusColor: info.statusColor,
      desc: info.desc,
      image: IMG[i % IMG.length],
      itemsCount: `${String(count).padStart(2, "0")} UNITS`,
      release: "2024.10",
    };
  });
---

<Layout
  title="AETHER | COLLECTIONS ARCHIVE"
  description="Browse seasonal systems, techwear collections, and legacy operational gear from Wannasingh."
>
  <div class="py-12 px-6 md:px-16 max-w-[1440px] mx-auto reveal">
    <!-- Header -->
    <header
      class="relative mb-16 border-b border-[var(--outline-variant)]/30 pb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-6"
    >
      <div>
        <p class="font-data-label text-xs text-[var(--secondary)] uppercase tracking-[0.2em]">
          Active Systems / Collections
        </p>
        <h1 class="font-display text-4xl text-[var(--primary)] uppercase leading-none mt-1">
          Collections
        </h1>
      </div>
      <p
        class="font-data-value text-xs text-[var(--on-surface-variant)] max-w-xs md:text-right leading-relaxed"
      >
        {totalProducts} PRODUCTS ACROSS {collections.length} PERFORMANCE CATEGORIES. DOCUMENTING THE EVOLUTION
        OF WANNASINGH SYSTEMS.
      </p>
    </header>

    <!-- Collections List -->
    <div class="space-y-16">
      {
        collections.map((col, index) => {
          const isEven = index % 2 === 0;
          return (
            <div
              class={`flex flex-col lg:flex-row gap-12 items-center ${isEven ? "" : "lg:flex-row-reverse"}`}
            >
              {/* Image Panel */}
              <div class="w-full lg:w-1/2 aspect-[16/10] bg-[var(--surface-container-high)] border border-[var(--outline-variant)]/30 overflow-hidden relative group">
                <img
                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-[1.03] transition-all duration-700"
                  alt={col.title}
                  src={col.image}
                />
                <div class="absolute top-4 left-4 bg-[var(--surface)]/90 backdrop-blur-md px-3 py-1.5 border border-[var(--outline-variant)]/20 font-data-label text-[10px] text-[var(--primary)] uppercase">
                  RELEASE: {col.release}
                </div>
              </div>

              {/* Description Panel */}
              <div class="w-full lg:w-1/2 space-y-6">
                <div class="flex items-center gap-3">
                  <span
                    class="w-2 h-2 rounded-none animate-pulse"
                    style={`background-color: ${col.statusColor}`}
                  />
                  <span
                    class="font-data-label text-xs tracking-wider"
                    style={`color: ${col.statusColor}`}
                  >
                    {col.status}
                  </span>
                </div>

                <h2 class="font-headline-lg text-2xl font-bold uppercase text-[var(--primary)] tracking-tight">
                  {col.title}
                </h2>

                <p class="font-body-md text-sm text-[var(--on-surface-variant)] leading-relaxed">
                  {col.desc}
                </p>

                <div class="flex items-center gap-8 pt-4 border-t border-[var(--outline-variant)]/20">
                  <div>
                    <span class="block font-data-label text-[9px] text-[var(--outline)] uppercase">
                      SYSTEM SCALE
                    </span>
                    <span class="font-data-value text-sm text-[var(--primary)]">
                      {col.itemsCount}
                    </span>
                  </div>
                  <div>
                    <span class="block font-data-label text-[9px] text-[var(--outline)] uppercase">
                      OPERATIONAL DEPTH
                    </span>
                    <span class="font-data-value text-sm text-[var(--primary)]">100% SECURE</span>
                  </div>
                </div>

                <div class="pt-6">
                  <a
                    href="/shop"
                    class="inline-flex items-center gap-3 bg-[var(--primary)] text-[var(--on-primary)] px-8 py-4 font-data-label text-xs tracking-widest hover:bg-[var(--secondary)] transition-all no-underline uppercase"
                  >
                    EXPLORE UNITS
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Layout>
