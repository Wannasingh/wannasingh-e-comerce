---
// checkout.astro — Secure Checkout Page | AETHER Cyber-Minimalism
import Layout from "../layouts/Layout.astro";

// Static items in cart for checkout demonstration
const checkoutItems = [
  {
    id: "apex-shell",
    name: "Apex Shell Jacket",
    spec: "MATTE CARBON / LARGE",
    qty: "01",
    price: 840.00,
    image: "https://lh3.googleusercontent.com/aida-public/AB6AXuByPYHF0BBdLiAgxQp-Pg12NN71mOHtneRyYZeCDeuKuFbtHC-KI-hb3knevfyPAPAAML05BzLdSQ0QuHhsIiWH3LCnYmO_2GGxeAZzeb7NcVKo_IvwxKNdMYRAdjxYmEm2eQ3Qj6fSNKOT5bSVuGFLx07SYWZdhNXLE3o0MiGzq6ebVh5JChjCFlZ6Pdm3s1m0ZnQGpdDQtwgz9g1hEr2ke_XccIzH-O2GkzZ1V1PKy4YZNNXuUgIuY_7cquH8HNxHkXGJMTMOMMVN"
  },
  {
    id: "modular-pouch",
    name: "Tactical Modular Pouch",
    spec: "OBSIDIAN / OS",
    qty: "01",
    price: 120.00,
    image: "https://lh3.googleusercontent.com/aida-public/AB6AXuA9jiJDMQ5Ced4l3JX8Tj6kre4mx1Zs4kpWYOzBXxCRcLnrENVLIFDeUBUzGLYbwuK994V7ei79nV5t_V9X8JP8-2sxELZJdR_C_RpVuT09nBnhNGwVU6nkL1k0wwm_1UgN_HXhT5xMUFLJBPS3LHjh4TKJwWAbCsWHw6ltsIp1Fp8E_EY5efKw8ZWj1jkkumGZQqQpkiI5VmyFKW_zIvArrVaBt9MYztgAnUMMKCS9PQwuJs1jRe1cQxh-1hTwMG50LjoQpux2X63c"
  }
];

const subtotal = checkoutItems.reduce((acc, item) => acc + item.price, 0);
const shipping = 0; // FREE
const total = subtotal + shipping;
---

<Layout title="AETHER | SECURE CHECKOUT" description="Secure billing, payment and shipping protocol. Deploy purchase.">
  <div class="py-12 px-4 md:px-16 max-w-[1440px] mx-auto reveal">
    <!-- Checkout Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      
      <!-- Left Column: Shipping & Payment Information -->
      <div class="lg:col-span-7 space-y-12">
        <section>
          <div class="flex items-center justify-between mb-8">
            <h1 class="font-headline-lg text-3xl uppercase tracking-tight text-[var(--primary)]">Checkout</h1>
            <span class="font-data-label text-xs tracking-wider text-[var(--on-surface-variant)]">STEP 01 / 03</span>
          </div>

          <!-- Express Checkout -->
          <div class="grid grid-cols-2 gap-4 mb-12">
            <button 
              type="button"
              class="bg-[var(--primary)] text-[var(--on-primary)] py-4 flex items-center justify-center space-x-2 hover:bg-[var(--secondary)] transition-all cursor-pointer"
            >
              <span class="font-data-label text-xs tracking-widest">APPLE PAY</span>
            </button>
            <button 
              type="button"
              class="border border-[var(--outline-variant)] py-4 flex items-center justify-center space-x-2 hover:border-[var(--secondary)] hover:text-[var(--secondary)] transition-all cursor-pointer"
            >
              <span class="font-data-label text-xs tracking-widest">GOOGLE PAY</span>
            </button>
          </div>

          <!-- Checkout Form -->
          <form id="checkout-form" class="space-y-8">
            <!-- Shipping Form -->
            <div class="border-b border-[var(--outline-variant)] pb-8">
              <h2 class="font-data-label text-sm uppercase text-[var(--on-surface-variant)] mb-6 tracking-widest">
                Shipping Information
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                <div class="relative border-b border-[var(--outline-variant)] py-1">
                  <label class="block font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] mb-1 tracking-wider">
                    First Name
                  </label>
                  <input 
                    required 
                    name="firstName" 
                    class="w-full bg-transparent border-none p-0 pb-1 font-body-md text-[var(--on-surface)] placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:ring-0" 
                    placeholder="ERIK" 
                    type="text"
                  />
                </div>
                <div class="relative border-b border-[var(--outline-variant)] py-1">
                  <label class="block font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] mb-1 tracking-wider">
                    Last Name
                  </label>
                  <input 
                    required 
                    name="lastName" 
                    class="w-full bg-transparent border-none p-0 pb-1 font-body-md text-[var(--on-surface)] placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:ring-0" 
                    placeholder="VON S." 
                    type="text"
                  />
                </div>
                <div class="md:col-span-2 relative border-b border-[var(--outline-variant)] py-1">
                  <label class="block font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] mb-1 tracking-wider">
                    Address
                  </label>
                  <input 
                    required 
                    name="address" 
                    class="w-full bg-transparent border-none p-0 pb-1 font-body-md text-[var(--on-surface)] placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:ring-0" 
                    placeholder="TECHNICAL DISTRICT, 402" 
                    type="text"
                  />
                </div>
                <div class="relative border-b border-[var(--outline-variant)] py-1">
                  <label class="block font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] mb-1 tracking-wider">
                    City
                  </label>
                  <input 
                    required 
                    name="city" 
                    class="w-full bg-transparent border-none p-0 pb-1 font-body-md text-[var(--on-surface)] placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:ring-0" 
                    placeholder="REYKJAVIK" 
                    type="text"
                  />
                </div>
                <div class="relative border-b border-[var(--outline-variant)] py-1">
                  <label class="block font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] mb-1 tracking-wider">
                    Postal Code
                  </label>
                  <input 
                    required 
                    name="postalCode" 
                    class="w-full bg-transparent border-none p-0 pb-1 font-body-md text-[var(--on-surface)] placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:ring-0" 
                    placeholder="101" 
                    type="text"
                  />
                </div>
              </div>
            </div>

            <!-- Payment Form -->
            <div class="pt-4">
              <h2 class="font-data-label text-sm uppercase text-[var(--on-surface-variant)] mb-6 tracking-widest">
                Secure Payment
              </h2>
              <div class="space-y-6">
                <div class="relative border-b border-[var(--outline-variant)] py-1">
                  <label class="block font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] mb-1 tracking-wider">
                    Card Number
                  </label>
                  <div class="flex items-center">
                    <input 
                      required 
                      name="cardNumber" 
                      class="flex-grow bg-transparent border-none p-0 pb-1 font-data-value text-[var(--on-surface)] placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:ring-0" 
                      placeholder="0000 0000 0000 0000" 
                      type="text"
                    />
                    <span class="material-symbols-outlined text-[var(--outline-variant)] pb-1" style="font-size: 20px;">credit_card</span>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-x-6">
                  <div class="relative border-b border-[var(--outline-variant)] py-1">
                    <label class="block font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] mb-1 tracking-wider">
                      Expiry Date
                    </label>
                    <input 
                      required 
                      name="expiry" 
                      class="w-full bg-transparent border-none p-0 pb-1 font-data-value text-[var(--on-surface)] placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:ring-0" 
                      placeholder="MM / YY" 
                      type="text"
                    />
                  </div>
                  <div class="relative border-b border-[var(--outline-variant)] py-1">
                    <label class="block font-data-label text-[10px] uppercase text-[var(--on-surface-variant)] mb-1 tracking-wider">
                      CVC
                    </label>
                    <input 
                      required 
                      name="cvc" 
                      class="w-full bg-transparent border-none p-0 pb-1 font-data-value text-[var(--on-surface)] placeholder:text-[var(--outline-variant)]/50 focus:outline-none focus:ring-0" 
                      placeholder="000" 
                      type="text"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit"
              class="w-full bg-[var(--primary)] text-[var(--on-primary)] py-6 font-data-label text-sm tracking-[0.2em] hover:bg-[var(--secondary)] transition-all duration-500 group flex items-center justify-center space-x-4 cursor-pointer"
            >
              <span>CONFIRM PURCHASE</span>
              <span class="material-symbols-outlined group-hover:translate-x-2 transition-transform" style="font-size: 20px;">arrow_forward</span>
            </button>
          </form>
        </section>
      </div>

      <!-- Right Column: Order Summary -->
      <div class="lg:col-span-5">
        <div class="sticky top-32 bg-[var(--surface-container-low)] p-8 border border-[var(--outline-variant)]/30">
          <h2 class="font-data-label text-sm uppercase mb-8 pb-4 border-b border-[var(--outline-variant)] tracking-widest">
            Order Summary
          </h2>
          
          <div class="space-y-6 mb-12">
            {checkoutItems.map((item) => (
              <div class="flex space-x-4">
                <div class="w-24 h-32 bg-[var(--surface-container-highest)] flex-shrink-0 overflow-hidden">
                  <img 
                    class="w-full h-full object-cover grayscale brightness-95 hover:grayscale-0 transition-all duration-500" 
                    alt={item.name}
                    src={item.image}
                  />
                </div>
                <div class="flex-grow flex flex-col justify-between py-1">
                  <div>
                    <h3 class="font-body-md text-base font-bold uppercase tracking-tight text-[var(--primary)]">
                      {item.name}
                    </h3>
                    <p class="font-data-label text-[10px] text-[var(--on-surface-variant)] mt-1">{item.spec}</p>
                  </div>
                  <div class="flex justify-between items-end">
                    <span class="font-data-label text-xs text-[var(--on-surface-variant)]">QTY: {item.qty}</span>
                    <span class="font-data-value text-sm text-[var(--secondary)] font-medium">${item.price.toFixed(2)}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="space-y-4 pt-8 border-t border-[var(--outline-variant)]">
            <div class="flex justify-between font-data-label text-xs">
              <span class="text-[var(--on-surface-variant)]">SUBTOTAL</span>
              <span class="text-[var(--on-surface)]">${subtotal.toFixed(2)}</span>
            </div>
            <div class="flex justify-between font-data-label text-xs">
              <span class="text-[var(--on-surface-variant)]">SHIPPING</span>
              <span class="text-[var(--secondary)]">FREE</span>
            </div>
            <div class="flex justify-between font-headline-md text-lg font-bold pt-4 border-t border-[var(--outline-variant)]/30">
              <span class="text-[var(--primary)]">TOTAL</span>
              <span class="text-[var(--primary)]">${total.toFixed(2)}</span>
            </div>
          </div>

          <div class="mt-8 flex items-start space-x-3 text-[var(--on-surface-variant)]">
            <span class="material-symbols-outlined text-[18px]" style="font-size: 18px;">lock</span>
            <p class="font-caption text-[11px] leading-relaxed">
              Payment data is encrypted and transmitted via secure protocols. AES-256 system active.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Success Modal -->
  <div id="success-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-[var(--primary)]/40 backdrop-blur-md hidden opacity-0 transition-opacity duration-300">
    <div class="bg-[var(--surface)] border border-[var(--outline-variant)] p-8 max-w-md w-full mx-4 shadow-2xl relative">
      <div class="text-center space-y-6">
        <div class="w-16 h-16 bg-[var(--secondary)]/10 text-[var(--secondary)] flex items-center justify-center mx-auto">
          <span class="material-symbols-outlined" style="font-size: 36px;">task_alt</span>
        </div>
        <div>
          <h3 class="font-headline-md text-xl uppercase tracking-tight">TRANSACTION SECURED</h3>
          <p class="font-data-label text-[10px] text-[var(--secondary)] mt-1">STATUS: COMPLETED / AUTH_CODE: WS-OK-9812</p>
        </div>
        <p class="font-body-md text-sm text-[var(--on-surface-variant)]">
          Your order deployment was successful. System telemetry has generated dispatch logs. You will receive an intelligence update via email.
        </p>
        <div class="pt-4">
          <a 
            href="/shop"
            class="block w-full bg-[var(--primary)] text-[var(--on-primary)] py-4 font-data-label text-xs tracking-widest hover:bg-[var(--secondary)] transition-all no-underline"
          >
            RETURN TO TERMINAL
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Micro-interactions for form fields
    const inputs = document.querySelectorAll('input');
    inputs.forEach(input => {
      const container = input.closest('.relative');
      const label = container?.querySelector('label');
      
      input.addEventListener('focus', () => {
        if (container) {
          container.classList.remove('border-[var(--outline-variant)]');
          container.classList.add('border-[var(--secondary)]');
        }
        if (label) {
          label.classList.add('text-[var(--secondary)]');
        }
      });
      
      input.addEventListener('blur', () => {
        if (container) {
          container.classList.remove('border-[var(--secondary)]');
          container.classList.add('border-[var(--outline-variant)]');
        }
        if (label) {
          label.classList.remove('text-[var(--secondary)]');
        }
      });
    });

    // Form submission simulation
    const form = document.getElementById('checkout-form');
    const modal = document.getElementById('success-modal');
    
    if (form && modal) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Disable submit button during "processing"
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          const spanText = submitBtn.querySelector('span:first-child');
          if (spanText) spanText.textContent = "SECURING TRANSACTION...";
        }
        
        setTimeout(() => {
          // Show Success Modal
          modal.classList.remove('hidden');
          // Force layout reflow
          modal.offsetHeight;
          modal.classList.add('opacity-100');
        }, 1200);
      });
    }
  </script>
</Layout>
