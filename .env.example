# =============================================================================
# WANNASINGH E-COMMERCE — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# =============================================================================

# ─── Node Environment ────────────────────────────────────────────────────────
NODE_ENV=development

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Production Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local development replica set (used by docker-compose)
MONGODB_URI_LOCAL=mongodb://mongo:27017/wannasingh_ecommerce?replicaSet=rs0

# ─── MedusaJS Backend ────────────────────────────────────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_ONBOARDING_TYPE=default
# JWT secrets — use strong random values in production (openssl rand -base64 64)
JWT_SECRET=supersecret-change-me-in-production
COOKIE_SECRET=supersecret-change-me-in-production
# Redis for events/queues (optional for basic setup)
# REDIS_URL=redis://localhost:6379

# ─── Astro Frontend ──────────────────────────────────────────────────────────
# Public variables are exposed to the browser (prefix with PUBLIC_)
PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
PUBLIC_SITE_URL=http://localhost:4321

# ─── Docker / Container Registry ─────────────────────────────────────────────
REGISTRY=ghcr.io/wannasingh
IMAGE_TAG=latest

# ─── SonarQube ───────────────────────────────────────────────────────────────
SONAR_HOST_URL=http://localhost:9100
SONAR_TOKEN=your-sonarqube-token-here

# ─── Jenkins ─────────────────────────────────────────────────────────────────
# These are set as Jenkins credentials, not in this file.
# DOCKER_REGISTRY_CREDENTIALS_ID=docker-registry-creds
# SONAR_CREDENTIALS_ID=sonarqube-token
